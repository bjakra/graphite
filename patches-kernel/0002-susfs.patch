+
+SUS_LSM_ORIG_CALL(inode_removexattr, SUS_XATTR_MNT_ID_DECL
+		  struct dentry *dentry, const char *name)
+{
+	return fn(SUS_XATTR_MNT_ID_ARG dentry, name);
+}
+
+SUS_LSM_ORIG_CALL(path_notify, const struct path *path, u64 mask,
