+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0)
+#define SUS_SETATTR_MNT_ID_DECL	struct mnt_idmap *idmap,
+#define SUS_SETATTR_MNT_ID_ARG	idmap,
+#else
+#define SUS_SETATTR_MNT_ID_DECL
+#define SUS_SETATTR_MNT_ID_ARG
+#endif
