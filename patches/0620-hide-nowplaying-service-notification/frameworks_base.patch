+package com.android.systemui.statusbar.notification.collection.coordinator;
+
+import android.app.Notification;
+import android.service.notification.StatusBarNotification;
+
+import com.android.systemui.statusbar.notification.collection.NotifPipeline;
+import com.android.systemui.statusbar.notification.collection.NotificationEntry;
+import com.android.systemui.statusbar.notification.collection.coordinator.dagger.CoordinatorScope;
+import com.android.systemui.statusbar.notification.collection.listbuilder.pluggable.NotifFilter;
+
+import javax.inject.Inject;
+
+/**
+ * Graphite: hides the "running in the background" notification of Graphite's own system services.
+ * Now Playing is turned on and off in Graphite settings, and an app can't hide its own foreground
+ * service notification (Android raises a blocked channel back to low importance). Only that one
+ * channel is hidden; the service's other notifications (recognised songs, errors) still show.
+ */
+@CoordinatorScope
+public class GraphiteServiceNotifsCoordinator implements Coordinator {
+
+    private static final String NOW_PLAYING = "org.graphite.nowplaying";
+    private static final String NOW_PLAYING_SERVICE_CHANNEL = "graphite_background_service";
+
+    @Inject
+    GraphiteServiceNotifsCoordinator() { }
+
+    @Override
+    public void attach(NotifPipeline pipeline) {
+        pipeline.addPreGroupFilter(mFilter);
+    }
+
+    private final NotifFilter mFilter = new NotifFilter("GraphiteServiceNotifsFilter") {
+        @Override
+        public boolean shouldFilterOut(NotificationEntry entry, long now) {
+            StatusBarNotification sbn = entry.getSbn();
+            Notification n = sbn.getNotification();
+            return NOW_PLAYING.equals(sbn.getPackageName())
+                    && (n.flags & Notification.FLAG_FOREGROUND_SERVICE) != 0
+                    && NOW_PLAYING_SERVICE_CHANNEL.equals(n.getChannelId());
+        }
+    };
+}
