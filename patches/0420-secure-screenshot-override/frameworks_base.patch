@@ -20,6 +20,7 @@ import android.app.IActivityTaskManager
 import android.graphics.Bitmap
 import android.graphics.Rect
 import android.view.IWindowManager
+import android.window.ScreenCapture
 import android.window.ScreenCaptureInternal
 import android.window.ScreenCaptureInternal.CaptureArgs
 import android.window.TaskSnapshotManager
@@ -40,8 +41,22 @@ constructor(
     @Background private val bgContext: CoroutineDispatcher,
 ) : ImageCapture {
 
-    override fun captureDisplay(displayId: Int, crop: Rect?): Bitmap? {
-        val captureArgs = CaptureArgs.Builder().setSourceCrop(crop).build()
+    override fun captureDisplay(displayId: Int, crop: Rect?): Bitmap? =
+        captureDisplay(displayId, crop, captureSecure = false)
+
+    override fun captureDisplay(displayId: Int, crop: Rect?, captureSecure: Boolean): Bitmap? {
+        val captureArgs =
+            CaptureArgs.Builder()
+                .setSourceCrop(crop)
+                .apply {
+                    // Graphite: system screenshot of an app on the secure-override list
+                    if (captureSecure) {
+                        setSecureContentPolicy(
+                            ScreenCapture.ScreenCaptureParams.SECURE_CONTENT_POLICY_CAPTURE
+                        )
+                    }
+                }
+                .build()
         val syncScreenCapture = ScreenCaptureInternal.createSyncCaptureListener()
         windowManager.captureDisplay(displayId, captureArgs, syncScreenCapture)
         val buffer = syncScreenCapture.getBuffer()
