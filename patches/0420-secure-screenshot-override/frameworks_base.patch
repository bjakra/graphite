+++ b/packages/SystemUI/src/com/android/systemui/screenshot/ImageCapture.kt
@@ -22,5 +22,12 @@ interface ImageCapture {
 
     fun captureDisplay(displayId: Int, crop: Rect? = null): Bitmap?
 
+    /**
+     * Graphite: like [captureDisplay], optionally including FLAG_SECURE layers. Only used for
+     * apps on the user's secure-override list.
+     */
+    fun captureDisplay(displayId: Int, crop: Rect?, captureSecure: Boolean): Bitmap? =
+        captureDisplay(displayId, crop)
+
     suspend fun captureTask(taskId: Int): Bitmap?
 }
