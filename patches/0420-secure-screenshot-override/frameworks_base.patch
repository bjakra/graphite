+package com.android.systemui.screenshot
+
+import android.content.Context
+import android.os.UserHandle
+import android.provider.Settings
+
+/**
+ * Graphite: per-app FLAG_SECURE override for *system* screenshots only.
+ *
+ * Apps listed in Settings.Secure `graphite_secure_override_packages` (comma-separated package
+ * names) keep FLAG_SECURE, so third-party capture, casting and recents thumbnails stay blacked
+ * out. Only SystemUI's own screenshots include their windows. With
+ * `graphite_secure_override_stealth` = 1, the app is also not told about the screenshot.
+ */
+object GraphiteSecureOverride {
+    const val PACKAGES = "graphite_secure_override_packages"
+    const val STEALTH = "graphite_secure_override_stealth"
+
+    fun isOverridden(context: Context?, packageName: String?): Boolean {
+        if (context == null || packageName.isNullOrEmpty()) return false
+        val list =
+            Settings.Secure.getStringForUser(
+                context.contentResolver, PACKAGES, UserHandle.USER_CURRENT
+            ) ?: return false
+        return list.split(',').any { it.trim() == packageName }
+    }
+
+    fun isStealth(context: Context?, packageName: String?): Boolean =
+        isOverridden(context, packageName) &&
+            Settings.Secure.getIntForUser(
+                context!!.contentResolver, STEALTH, 0, UserHandle.USER_CURRENT
+            ) == 1
+}
