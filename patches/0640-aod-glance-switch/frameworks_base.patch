From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bjarne <87858321+bjakra@users.noreply.github.com>
Date: Thu, 5 Nov 2026 15:11:50 +0100
Subject: [PATCH] SystemUI: separate switch for At a Glance on the always-on
 display

LockscreenSmartspaceGeneralView reads graphite_aod_at_a_glance (default on) next to graphite_lockscreen_at_a_glance and
fades between the two with the doze amount, so each one can be on without the other.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01A7tdbTAv6xiqf4SbJWNdwp

---
 .../LockscreenSmartspaceGeneralView.java      | 45 ++++++++++++++-----
 1 file changed, 33 insertions(+), 12 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/smartspace/LockscreenSmartspaceGeneralView.java b/packages/SystemUI/src/com/android/systemui/keyguard/smartspace/LockscreenSmartspaceGeneralView.java
index 820e1489e29f6ba8f0a449457d2b334f557c0314..1062c4115fd934d6cc82adb7fa33d97a8dc3661e 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/smartspace/LockscreenSmartspaceGeneralView.java
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/smartspace/LockscreenSmartspaceGeneralView.java
@@ -40,12 +40,17 @@ public class LockscreenSmartspaceGeneralView extends LinearLayout implements Def
 
     /** Graphite: switch in Graphite settings, Lock screen, At a Glance (default on). */
     public static final String SETTING_SHOW = "graphite_lockscreen_at_a_glance";
-    private SmartspaceTarget mTarget;
+    /** Graphite: the same for the always-on display (default on). */
+    public static final String SETTING_SHOW_AOD = "graphite_aod_at_a_glance";
+    private boolean mShowOnLockscreen = true;
+    private boolean mShowOnAod = true;
+    private boolean mHasRows;
+    private float mDozeAmount;
     private final ContentObserver mSettingObserver = new ContentObserver(
             new Handler(Looper.getMainLooper())) {
         @Override
         public void onChange(boolean selfChange) {
-            if (mTarget != null) showTarget(mTarget);
+            readSettings();
         }
     };
 
@@ -66,7 +71,10 @@ public class LockscreenSmartspaceGeneralView extends LinearLayout implements Def
         super.onAttachedToWindow();
         mContext.getContentResolver().registerContentObserver(
                 Settings.Secure.getUriFor(SETTING_SHOW), false, mSettingObserver, UserHandle.USER_ALL);
-        if (mTarget != null) showTarget(mTarget);
+        mContext.getContentResolver().registerContentObserver(
+                Settings.Secure.getUriFor(SETTING_SHOW_AOD), false, mSettingObserver,
+                UserHandle.USER_ALL);
+        readSettings();
     }
 
     @Override
@@ -75,24 +83,37 @@ public class LockscreenSmartspaceGeneralView extends LinearLayout implements Def
         super.onDetachedFromWindow();
     }
 
-    private boolean isShownOnLockscreen() {
-        return Settings.Secure.getIntForUser(mContext.getContentResolver(), SETTING_SHOW, 1,
-                UserHandle.USER_CURRENT) != 0;
+    private void readSettings() {
+        mShowOnLockscreen = Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                SETTING_SHOW, 1, UserHandle.USER_CURRENT) != 0;
+        mShowOnAod = Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                SETTING_SHOW_AOD, 1, UserHandle.USER_CURRENT) != 0;
+        updateRowsVisibility();
+    }
+
+    @Override
+    public void setDozeAmount(float amount) {
+        mDozeAmount = amount;
+        updateRowsVisibility();
+    }
+
+    /** Graphite: fades between the lock screen's and the always-on display's switch while the display changes. */
+    private void updateRowsVisibility() {
+        float alpha = (mShowOnLockscreen ? 1 - mDozeAmount : 0) + (mShowOnAod ? mDozeAmount : 0);
+        mRows.setAlpha(alpha);
+        mRows.setVisibility(mHasRows && alpha > 0 ? View.VISIBLE : View.GONE);
     }
 
     protected void showTarget(SmartspaceTarget target) {
-        mTarget = target;
         var template = (CombinedCardsTemplateData) requireNonNull(target.getTemplateData());
         List<BaseTemplateData> subTemplates = template.getCombinedCardDataList();
 
-        // Graphite: hidden on the lock screen and AOD when switched off in Graphite settings
-        if (subTemplates.isEmpty() || !isShownOnLockscreen()) {
-            mRows.setVisibility(View.GONE);
+        mHasRows = !subTemplates.isEmpty();
+        updateRowsVisibility();
+        if (!mHasRows) {
             return;
         }
 
-        mRows.setVisibility(View.VISIBLE);
-
         int viewIdx = 0;
 
         final int textColor = ColorUtils.blendARGB(
