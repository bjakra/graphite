Subject: [PATCH] Power menu: restart submenu and haptics

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../GlobalActionsDialogLite.java              | 72 ++++++++++++++++---
 .../globalactions/GraphiteRestartMenu.kt      | 30 ++++++++
 2 files changed, 91 insertions(+), 11 deletions(-)
 create mode 100644 packages/SystemUI/src/com/android/systemui/globalactions/GraphiteRestartMenu.kt

diff --git a/packages/SystemUI/src/com/android/systemui/globalactions/GlobalActionsDialogLite.java b/packages/SystemUI/src/com/android/systemui/globalactions/GlobalActionsDialogLite.java
index 784f6ad534510d3e1ff45ed83d976fc7a5374924..c39e5eaf69463b1882efb5e6177a5cff3e619982 100644
--- a/packages/SystemUI/src/com/android/systemui/globalactions/GlobalActionsDialogLite.java
+++ b/packages/SystemUI/src/com/android/systemui/globalactions/GlobalActionsDialogLite.java
@@ -80,6 +80,7 @@ import android.view.IWindowManager;
 import android.view.LayoutInflater;
 import android.view.MotionEvent;
 import android.view.Surface;
+import android.view.HapticFeedbackConstants;
 import android.view.View;
 import android.view.ViewGroup;
 import android.view.Window;
@@ -796,16 +797,44 @@ public class GlobalActionsDialogLite implements DialogInterface.OnDismissListene
 
         addIfShouldShowAction(tempActions, restartSafeModeAction);
 
+        // Graphite: restart, recovery, bootloader and SystemUI restart can share one Restart button
+        // that opens a submenu, like other custom ROMs
+        if (GraphiteRestartMenu.isEnabled(mContext) && tempActions.contains(restartAction)) {
+            ArrayList<Action> restartTargets = new ArrayList<>();
+            for (Action action : tempActions) {
+                if (action instanceof AdvancedRestartAction
+                        || action instanceof RestartSystemUiAction) {
+                    restartTargets.add(action);
+                }
+            }
+            if (!restartTargets.isEmpty()) {
+                int restartIndex = tempActions.indexOf(restartAction);
+                tempActions.removeAll(restartTargets);
+                tempActions.remove(restartAction);
+                mPowerItems.add(restartAction);
+                mPowerItems.addAll(restartTargets);
+                tempActions.add(restartIndex, new PowerOptionsAction(true));
+            }
+        }
+
         // replace power and restart with a single power options action, if needed
-        if (tempActions.contains(shutdownAction) && tempActions.contains(restartAction)
+        Action restartMenu = null;
+        for (Action action : tempActions) {
+            if (action instanceof PowerOptionsAction) restartMenu = action;
+        }
+        if (tempActions.contains(shutdownAction)
+                && (tempActions.contains(restartAction) || restartMenu != null)
                 && tempActions.size() > getMaxShownPowerItems()) {
+            if (restartMenu != null) tempActions.remove(restartMenu);
             // transfer shutdown and restart to their own list of power actions
-            int powerOptionsIndex = Math.min(tempActions.indexOf(restartAction),
-                    tempActions.indexOf(shutdownAction));
+            int powerOptionsIndex = tempActions.indexOf(shutdownAction);
+            if (tempActions.contains(restartAction)) {
+                powerOptionsIndex = Math.min(powerOptionsIndex, tempActions.indexOf(restartAction));
+            }
             tempActions.remove(shutdownAction);
             tempActions.remove(restartAction);
-            mPowerItems.add(shutdownAction);
-            mPowerItems.add(restartAction);
+            mPowerItems.add(0, shutdownAction);
+            if (!mPowerItems.contains(restartAction)) mPowerItems.add(1, restartAction);
             // Graphite: advanced restart targets go into the same submenu
             for (Action action : new ArrayList<>(tempActions)) {
                 if (action instanceof AdvancedRestartAction
@@ -949,8 +978,15 @@ public class GlobalActionsDialogLite implements DialogInterface.OnDismissListene
 
     private final class PowerOptionsAction extends SinglePressAction {
         private PowerOptionsAction() {
-            super(com.android.systemui.res.R.drawable.ic_settings_power,
-                    R.string.global_action_power_options);
+            this(false);
+        }
+
+        /** Graphite: as the Restart button, it opens the restart targets instead */
+        private PowerOptionsAction(boolean restartMenu) {
+            super(restartMenu ? com.android.systemui.res.R.drawable.ic_global_actions_restart
+                            : com.android.systemui.res.R.drawable.ic_settings_power,
+                    restartMenu ? R.string.global_action_restart
+                            : R.string.global_action_power_options);
         }
 
         @Override
@@ -1883,9 +1919,16 @@ public class GlobalActionsDialogLite implements DialogInterface.OnDismissListene
                 }
             });
 
-            view.setOnClickListener(v -> onClickItem(position));
+            view.setOnClickListener(v -> {
+                // Graphite: a haptic tick on every power menu tap
+                v.performHapticFeedback(HapticFeedbackConstants.CONTEXT_CLICK);
+                onClickItem(position);
+            });
             if (action instanceof LongPressAction) {
-                view.setOnLongClickListener(v -> onLongClickItem(position));
+                view.setOnLongClickListener(v -> {
+                    v.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS);
+                    return onLongClickItem(position);
+                });
             }
             return view;
         }
@@ -1961,9 +2004,16 @@ public class GlobalActionsDialogLite implements DialogInterface.OnDismissListene
             int viewLayoutResource = com.android.systemui.res.R.layout.global_actions_power_item;
             View view = convertView != null ? convertView
                     : LayoutInflater.from(mContext).inflate(viewLayoutResource, parent, false);
-            view.setOnClickListener(v -> onClickItem(position));
+            view.setOnClickListener(v -> {
+                // Graphite: a haptic tick on every power menu tap
+                v.performHapticFeedback(HapticFeedbackConstants.CONTEXT_CLICK);
+                onClickItem(position);
+            });
             if (action instanceof LongPressAction) {
-                view.setOnLongClickListener(v -> onLongClickItem(position));
+                view.setOnLongClickListener(v -> {
+                    v.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS);
+                    return onLongClickItem(position);
+                });
             }
             ImageView icon = view.findViewById(R.id.icon);
             TextView messageView = view.findViewById(R.id.message);
diff --git a/packages/SystemUI/src/com/android/systemui/globalactions/GraphiteRestartMenu.kt b/packages/SystemUI/src/com/android/systemui/globalactions/GraphiteRestartMenu.kt
new file mode 100644
index 0000000000000000000000000000000000000000..3e1b521b57a7e6b314206161dc6d9fc7b6b608d3
