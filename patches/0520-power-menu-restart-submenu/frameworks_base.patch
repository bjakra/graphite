+package com.android.systemui.globalactions
+
+import android.content.Context
+import android.os.UserHandle
+import android.provider.Settings
+
+/** Graphite: whether Restart opens a submenu with the advanced restart targets. On by default. */
+object GraphiteRestartMenu {
+    const val SETTING = "graphite_power_menu_restart_submenu"
+
+    @JvmStatic
+    fun isEnabled(context: Context): Boolean =
+        Settings.Secure.getIntForUser(context.contentResolver, SETTING, 1, UserHandle.USER_CURRENT) != 0
+}
