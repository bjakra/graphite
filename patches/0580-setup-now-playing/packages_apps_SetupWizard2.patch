--- /dev/null
+++ b/java/app/grapheneos/setupwizard/view/activity/NowPlayingActivity.kt
@@ -0,0 +1,46 @@
+package app.grapheneos.setupwizard.view.activity
+
+import android.net.Uri
+import android.os.Bundle
+import app.grapheneos.setupwizard.R
+import app.grapheneos.setupwizard.action.SetupWizard
+
+/**
+ * Graphite: optional step for Now Playing (on-device song recognition), off unless turned on here or later in
+ * Graphite settings. Skipped when Graphite Now Playing isn't installed.
+ */
+class NowPlayingActivity : SetupWizardActivity(
+    R.layout.activity_now_playing,
+    R.drawable.baseline_music_note_glif,
+    R.string.now_playing_title,
+    R.string.now_playing_desc
+) {
+    companion object {
+        private const val AUTHORITY = "org.graphite.nowplaying.api"
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        if (packageManager.resolveContentProvider(AUTHORITY, 0) == null) {
+            SetupWizard.next(this)
+            finish()
+        }
+    }
+
+    override fun bindViews() {
+        primaryButton.setText(this, R.string.now_playing_turn_on)
+        secondaryButton.setText(this, R.string.now_playing_not_now)
+    }
+
+    override fun setupActions() {
+        secondaryButton.setOnClickListener { SetupWizard.next(this) }
+        primaryButton.setOnClickListener {
+            // The same switch as Graphite settings, Now Playing
+            runCatching {
+                contentResolver.call(Uri.parse("content://$AUTHORITY"), "setEnabled", null,
+                    Bundle().apply { putBoolean("value", true) })
+            }
+            SetupWizard.next(this)
+        }
+    }
+}
