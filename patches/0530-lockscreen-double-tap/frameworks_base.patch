@@ -84,11 +84,19 @@ class TouchHandlingViewInteractionHandler(
                 override fun onDoubleTap(event: MotionEvent): Boolean {
                     if (isDoubleTapHandlingEnabled) {
                         doubleTapAwaitingUp = true
-                        lastDoubleTapDownEventTime = event.eventTime
                         return true
                     }
                     return false
                 }
+
+                // Graphite: not in onDoubleTap, which gets the first tap's down event. That made the time
+                // limit below cover both taps, 300 ms in total, which a normal double tap often misses.
+                override fun onDoubleTapEvent(event: MotionEvent): Boolean {
+                    if (event.actionMasked == MotionEvent.ACTION_DOWN) {
+                        lastDoubleTapDownEventTime = event.eventTime
+                    }
+                    return isDoubleTapHandlingEnabled
+                }
             },
         )
 
