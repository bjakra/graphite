@@ -304,10 +306,24 @@ public class DozeTriggers implements DozeMachine.Part {
         }
     }
 
+    private static final long GRAPHITE_DOUBLE_TAP_MILLIS = 600;
+    private long mGraphiteLastTap;
+
     @VisibleForTesting
     void onSensor(int pulseReason, float screenX, float screenY, float[] rawValues) {
         boolean isDoubleTap = pulseReason == DozeLog.REASON_SENSOR_DOUBLE_TAP;
         boolean isTap = pulseReason == DozeLog.REASON_SENSOR_TAP;
+        // Graphite: double tap to wake on devices with only a single tap sensor. The first tap is
+        // remembered, and only a second one shortly after wakes the screen.
+        if (isTap && Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                "graphite_double_tap_to_wake", 0, UserHandle.USER_CURRENT) == 1) {
+            long now = SystemClock.uptimeMillis();
+            if (now - mGraphiteLastTap > GRAPHITE_DOUBLE_TAP_MILLIS) {
+                mGraphiteLastTap = now;
+                return;
+            }
+            mGraphiteLastTap = 0;
+        }
         boolean isPickup = pulseReason == DozeLog.REASON_SENSOR_PICKUP;
         boolean isLongPress = pulseReason == DozeLog.PULSE_REASON_SENSOR_LONG_PRESS;
         boolean isWakeOnPresence = pulseReason == DozeLog.REASON_SENSOR_WAKE_UP_PRESENCE;
From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bjarne <87858321+bjakra@users.noreply.github.com>
Date: Thu, 5 Nov 2026 15:11:50 +0100
Subject: [PATCH] Double tap to sleep and wake: make them work on the phone

Sleep: the keyguard touch view only accepted ACTION_DOWN when long press is enabled, so the double tap detector never
saw the rest of the gesture on phones without the lock screen customization.
Wake: PulsingGestureListener still woke on a single tap while the display wasn't in its low power state. In that state
the tap sensor reports one event for two quick taps and doesn't re-arm by itself, so swallowing the first event left
nothing that could wake the screen. The first tap now lights up the screen (a pulse), which brings back the touch
screen for the second tap, and the sensor is re-armed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01A7tdbTAv6xiqf4SbJWNdwp

