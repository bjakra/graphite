@@ -0,0 +1,33 @@
+package com.android.systemui.doze;
+
+import android.os.SystemClock;
+
+/**
+ * Graphite: double tap to wake (Settings.Secure graphite_double_tap_to_wake) on a phone that only has a
+ * single tap sensor. Remembers the first tap, whichever way it arrived: from the sensor while the display is
+ * in its low power state ({@link DozeTriggers}), or from the touch screen while it's not
+ * ({@link com.android.systemui.shade.PulsingGestureListener}). Only used on the main thread.
+ */
+public final class GraphiteDoubleTap {
+    public static final String SETTING = "graphite_double_tap_to_wake";
+
+    /** Time for the second tap after a tap on the touch screen. */
+    public static final long TOUCH_WINDOW_MILLIS = 600;
+    /** Time for the second tap after a tap on the sensor, which includes the screen coming on. */
+    public static final long SENSOR_WINDOW_MILLIS = 3000;
+
+    private static long sSecondTapUntil;
+
+    private GraphiteDoubleTap() {}
+
+    /** Returns whether this tap is the second one; if not, it's remembered as the first one. */
+    public static boolean isSecondTap(long windowMillis) {
+        long now = SystemClock.uptimeMillis();
+        if (now < sSecondTapUntil) {
+            sSecondTapUntil = 0;
+            return true;
+        }
+        sSecondTapUntil = now + windowMillis;
+        return false;
+    }
+}
