+                }.isSuccess
+                refresh()
+                if (!ok) {
+                    Toast.makeText(context, R.string.keybox_bootkey_custom_invalid,
+                        Toast.LENGTH_LONG).show()
+                }
+            }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    private fun stateLabel(state: BootState): Int = when (state) {
+        BootState.VERIFIED -> R.string.keybox_bootstate_verified
+        BootState.SELFSIGNED -> R.string.keybox_bootstate_selfsigned
+    }
+
+    private fun hexInput(prefill: String?): EditText = EditText(requireContext()).apply {
+        inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS
+        hint = getString(R.string.keybox_bootkey_custom_hint)
+        setText(prefill ?: "")
+    }
 }
