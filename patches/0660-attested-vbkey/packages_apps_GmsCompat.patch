diff --git a/src/app/grapheneos/gmscompat/keybox/KeyboxStore.kt b/src/app/grapheneos/gmscompat/keybox/KeyboxStore.kt
index 34b7c634c2375a3fb64c80971e7e312204772c7b..8fe132f121cab6438bbaca767183bac3e5aa61ea 100644
--- a/src/app/grapheneos/gmscompat/keybox/KeyboxStore.kt
+++ b/src/app/grapheneos/gmscompat/keybox/KeyboxStore.kt
@@ -19,22 +19,38 @@ data class KeyboxState(
     val earliestExpiry: Date?,
 )
 
+/** Which verified boot key the re-signed attestation reports. See [KeyboxStore.bootKeyConfig]. */
+enum class BootKeyMode { ORIGINAL, GRAPHENE, CUSTOM }
+
+data class BootKeyConfig(val mode: BootKeyMode, val customHex: String?)
+
 /** Per-user, no-backup storage. The private key never leaves the GmsCompat process. */
 object KeyboxStore {
     private const val TAG = "PlayKeyboxStore"
     private const val KEYBOX_FILE = "play_keybox.xml"
     private const val ENABLED_FILE = "play_keybox.enabled"
+    private const val BOOTKEY_FILE = "play_keybox.bootkey"
+
+    // GrapheneOS' official husky (Pixel 8 Pro) verified boot key hash, reported with SelfSigned.
+    // User-provided; see the patch notes - verify against GrapheneOS' published husky AVB key and
+    // re-check on AVB key rotations.
+    private const val GRAPHENE_HUSKY_VBKEY_HEX =
+        "896DB2D09D84E1D6BB747002B8A114950B946E5825772A9D48BA7EB01D118C1C"
+    private const val VERIFIED_BOOT_STATE_SELF_SIGNED = 1
 
     private val lock = Any()
     private var loaded = false
     private var parsed: PlayKeybox.ParsedKeybox? = null
     private var enabled = false
+    // "original" | "graphene" | "custom:<64 hex>"; the verified boot key the rewrite reports.
+    private var bootKeyLine = "original"
 
     private val ctx: Context
         get() = App.ctx()
 
     private fun keyboxFile() = File(ctx.noBackupFilesDir, KEYBOX_FILE)
     private fun enabledFile() = File(ctx.noBackupFilesDir, ENABLED_FILE)
+    private fun bootKeyFile() = File(ctx.noBackupFilesDir, BOOTKEY_FILE)
 
     private fun isUserUnlocked(): Boolean {
         return ctx.getSystemService(UserManager::class.java)?.isUserUnlocked == true
@@ -44,6 +60,7 @@ object KeyboxStore {
         if (loaded || !isUserUnlocked()) return
         loaded = true
         enabled = runCatching { enabledFile().readText() == "1" }.getOrDefault(false)
+        bootKeyLine = runCatching { bootKeyFile().readText().trim() }.getOrDefault("original")
         parsed = if (keyboxFile().isFile) {
             try {
                 // Expiry is checked when the feature is used, not treated as file corruption.
@@ -103,8 +120,65 @@ object KeyboxStore {
         parsed = null
         enabled = false
         loaded = true
+        bootKeyLine = "original"
         AtomicFile(keyboxFile()).delete()
         AtomicFile(enabledFile()).delete()
+        AtomicFile(bootKeyFile()).delete()
+    }
+
+    /** The verified boot key mode the rewrite reports (off = ORIGINAL, the device's real key). */
+    fun bootKeyConfig(): BootKeyConfig = synchronized(lock) {
+        ensureLoadedLocked()
+        parseBootKeyLine(bootKeyLine)
+    }
+
+    /** Persists the verified boot key mode. A CUSTOM mode needs a valid 64-hex key or it throws. */
+    fun setBootKeyConfig(mode: BootKeyMode, customHex: String?): BootKeyConfig = synchronized(lock) {
+        ensureLoadedLocked()
+        val line = when (mode) {
+            BootKeyMode.ORIGINAL -> "original"
+            BootKeyMode.GRAPHENE -> "graphene"
+            BootKeyMode.CUSTOM -> "custom:" + (normalizeHex(customHex)
+                ?: throw IllegalArgumentException("verified boot key must be 64 hex characters"))
+        }
+        writeAtomic(bootKeyFile(), line.toByteArray())
+        bootKeyLine = line
+        parseBootKeyLine(line)
+    }
+
+    private fun parseBootKeyLine(line: String): BootKeyConfig = when {
+        line == "graphene" -> BootKeyConfig(BootKeyMode.GRAPHENE, null)
+        line.startsWith("custom:") && normalizeHex(line.substring(7)) != null ->
+            BootKeyConfig(BootKeyMode.CUSTOM, normalizeHex(line.substring(7)))
+        else -> BootKeyConfig(BootKeyMode.ORIGINAL, null)
+    }
+
+    /** The RootOfTrust override for the current mode, or null for ORIGINAL (keep the real key). */
+    private fun resolveOverrideLocked(): PlayKeybox.BootOverride? {
+        val cfg = parseBootKeyLine(bootKeyLine)
+        return when (cfg.mode) {
+            BootKeyMode.ORIGINAL -> null
+            BootKeyMode.GRAPHENE -> parseHex(GRAPHENE_HUSKY_VBKEY_HEX)?.let {
+                PlayKeybox.BootOverride(it, VERIFIED_BOOT_STATE_SELF_SIGNED)
+            }
+            BootKeyMode.CUSTOM -> cfg.customHex?.let { parseHex(it) }?.let {
+                PlayKeybox.BootOverride(it, VERIFIED_BOOT_STATE_SELF_SIGNED)
+            }
+        }
+    }
+
+    /** 64 hex chars (any case, whitespace/colons ignored) normalized to uppercase, or null. */
+    private fun normalizeHex(input: String?): String? {
+        val cleaned = input?.filterNot { it.isWhitespace() || it == ':' }?.uppercase() ?: return null
+        if (cleaned.length != 64 || !cleaned.all { it in "0123456789ABCDEF" }) return null
+        return cleaned
+    }
+
+    private fun parseHex(hex: String): ByteArray? {
+        val norm = normalizeHex(hex) ?: return null
+        return ByteArray(32) {
+            ((norm[it * 2].digitToInt(16) shl 4) or norm[it * 2 + 1].digitToInt(16)).toByte()
+        }
     }
 
     /**
@@ -117,7 +191,8 @@ object KeyboxStore {
         val current = parsed
         if (!enabled || current == null || !current.isValidNow()) return null
         return try {
-            val replacement = current.maybeRewrite(PlayKeybox.decodeChain(encodedChain))
+            val replacement = current.maybeRewrite(
+                PlayKeybox.decodeChain(encodedChain), resolveOverrideLocked())
                 ?: return null
             PlayKeybox.encodeChain(replacement)
         } catch (e: Exception) {
