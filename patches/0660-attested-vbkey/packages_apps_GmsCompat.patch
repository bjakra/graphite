+    /** Persists the key mode; returns false if a CUSTOM key was rejected (nothing changed). */
+    private fun applyKeyMode(mode: BootKeyMode, customHex: String?): Boolean {
+        val cur = KeyboxStore.bootConfig()
+        val ok = runCatching {
+            KeyboxStore.setBootConfig(cur.copy(keyMode = mode, customKeyHex = customHex))
+        }.isSuccess
         refresh()
+        if (ok) maybeOfferCoherentState(mode)
         return ok
     }
