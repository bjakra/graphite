+    // Graphite: the song Now Playing recognised nearby. Graphite Now Playing decides when a song is
+    // shown, like Ambient Music Mod's lock screen line (until the track's estimated end), and
+    // announces changes on its song URI.
+    private static final android.net.Uri NOW_PLAYING_API =
+            android.net.Uri.parse("content://org.graphite.nowplaying.api");
+    private static final android.net.Uri NOW_PLAYING_SONG =
+            android.net.Uri.parse("content://org.graphite.nowplaying.api/song");
+    private boolean mNowPlayingObserving;
+    private final Runnable mNowPlayingExpired = this::updateLockScreenNowPlayingMsg;
+
+    private void updateLockScreenNowPlayingMsg() {
+        if (!mNowPlayingObserving) {
+            mNowPlayingObserving = true;
+            try {
+                mContext.getContentResolver().registerContentObserver(NOW_PLAYING_SONG, false,
+                        new android.database.ContentObserver(null) {
+                            @Override
+                            public void onChange(boolean selfChange) {
+                                mExecutor.execute(() -> updateLockScreenNowPlayingMsg());
+                            }
+                        });
+            } catch (RuntimeException e) {
+                // Now Playing isn't installed
+            }
+        }
+        mBackgroundExecutor.execute(() -> {
+            String track = null;
+            String artist = null;
+            long endTime = 0;
+            try {
+                android.os.Bundle song = mContext.getContentResolver().call(
+                        NOW_PLAYING_API, "getSong", null, null);
+                if (song != null) {
+                    track = song.getString("track");
+                    artist = song.getString("artist");
+                    endTime = song.getLong("endTime");
+                }
+            } catch (RuntimeException e) {
+                // Not installed or not allowed: nothing to show
+            }
+            final long remaining = endTime - System.currentTimeMillis();
+            final String text = track == null || remaining <= 0 ? null
+                    : (artist == null ? "♪ " + track : "♪ " + track + " • " + artist);
+            mExecutor.execute(() -> {
+                if (text != null && mKeyguardStateController.isShowing()) {
+                    mRotateTextViewController.updateIndication(
+                            INDICATION_TYPE_NOW_PLAYING,
+                            new KeyguardIndication.Builder()
+                                    .setMessage(text)
+                                    .setTextColor(getInitialTextColorState())
+                                    .build(),
+                            false);
+                    mExecutor.executeDelayed(mNowPlayingExpired, remaining + 500);
+                } else {
+                    mRotateTextViewController.hideIndication(INDICATION_TYPE_NOW_PLAYING);
+                }
+            });
+        });
+    }
+
     private void updateLockScreenOwnerInfo() {
         // Check device owner info on a bg thread.
         // It makes multiple IPCs that could block the thread it's run on.
