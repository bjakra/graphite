+package com.android.systemui.globalactions
+
+import android.app.ActivityManager
+import android.app.ActivityOptions
+import android.content.ActivityNotFoundException
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.os.Bundle
+import android.os.Handler
+import android.os.Parcel
+import android.os.ResultReceiver
+import android.os.UserHandle
+import android.os.UserManager
+import android.provider.Settings
+import android.util.Log
+
+/**
+ * Graphite: opens Classic Power Menu. The app confirms through [EXTRA_ACK]. Anything else calls
+ * [fallback], so holding power always shows a menu: the app missing, disabled or crashing, setup not
+ * finished, or storage still locked after a reboot.
+ */
+object GraphitePowerMenu {
+    private const val TAG = "GraphitePowerMenu"
+    private const val SETTING = "graphite_classic_power_menu"
+    private const val EXTRA_ACK = "org.graphite.extra.POWER_MENU_ACK"
+    private const val ACK_TIMEOUT_MS = 2000L
+    private val COMPONENT =
+        ComponentName(
+            "com.kieronquinn.app.classicpowermenu",
+            "com.kieronquinn.app.classicpowermenu.ui.activities.PowerMenuActivity",
+        )
+
+    // Sent as a plain ResultReceiver, because the app can't load a SystemUI subclass
+    private fun plainReceiver(receiver: ResultReceiver): ResultReceiver {
+        val parcel = Parcel.obtain()
+        try {
+            receiver.writeToParcel(parcel, 0)
+            parcel.setDataPosition(0)
+            return ResultReceiver.CREATOR.createFromParcel(parcel)
+        } finally {
+            parcel.recycle()
+        }
+    }
+
+    @JvmStatic
+    fun show(
+        context: Context,
+        handler: Handler,
+        provisioned: Boolean,
+        displayId: Int,
+        shown: Runnable,
+        fallback: Runnable,
+    ) {
+        val user = ActivityManager.getCurrentUser()
+        val enabled =
+            Settings.Secure.getIntForUser(context.contentResolver, SETTING, 1, user) != 0
+        if (
+            !enabled ||
+                !provisioned ||
+                !context.getSystemService(UserManager::class.java)!!.isUserUnlocked(user)
+        ) {
+            fallback.run()
+            return
+        }
+        var answered = false
+        val timeout = Runnable {
+            if (answered) return@Runnable
+            answered = true
+            Log.w(TAG, "Classic Power Menu didn't open in time")
+            fallback.run()
+        }
+        val ack =
+            object : ResultReceiver(handler) {
+                override fun onReceiveResult(resultCode: Int, resultData: Bundle?) {
+                    if (answered) return
+                    answered = true
+                    handler.removeCallbacks(timeout)
+                    shown.run()
+                }
+            }
+        val intent =
+            Intent()
+                .setComponent(COMPONENT)
+                .addFlags(
+                    Intent.FLAG_ACTIVITY_NEW_TASK or
+                        Intent.FLAG_ACTIVITY_CLEAR_TOP or
+                        Intent.FLAG_ACTIVITY_EXCLUDE_FROM_RECENTS or
+                        Intent.FLAG_ACTIVITY_NO_ANIMATION or
+                        Intent.FLAG_ACTIVITY_REORDER_TO_FRONT
+                )
+                .putExtra(EXTRA_ACK, plainReceiver(ack))
+        val options = ActivityOptions.makeBasic().setLaunchDisplayId(displayId).toBundle()
+        try {
+            context.startActivityAsUser(intent, options, UserHandle.of(user))
+            handler.postDelayed(timeout, ACK_TIMEOUT_MS)
+        } catch (e: ActivityNotFoundException) {
+            answered = true
+            fallback.run()
+        } catch (e: SecurityException) {
+            Log.w(TAG, "Could not open Classic Power Menu", e)
+            answered = true
+            fallback.run()
+        }
+    }
+}
