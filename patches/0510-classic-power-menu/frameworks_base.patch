@@ -601,6 +601,16 @@ public class GlobalActionsDialogLite implements DialogInterface.OnDismissListene
     }
 
     private void handleShow(@Nullable Expandable expandable, int displayId) {
+        // Graphite: Classic Power Menu comes first. This dialog is what remains if it can't open.
+        GraphitePowerMenu.show(mContext, mMainHandler, mDeviceProvisioned, displayId,
+                () -> {
+                    mWindowManagerFuncs.onGlobalActionsShown();
+                    mWindowManagerFuncs.onGlobalActionsHidden();
+                },
+                () -> showSystemDialog(expandable, displayId));
+    }
+
+    private void showSystemDialog(@Nullable Expandable expandable, int displayId) {
         SystemUIDialog dialog = createDialog(displayId);
         prepareDialog();
 
