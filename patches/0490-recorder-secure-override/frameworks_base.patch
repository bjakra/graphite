+    /** Graphite: see {@link IWindowManager#setRecordingSecureOverride}. */
+    @Override
+    public void setRecordingSecureOverride(IBinder token, String[] packages, int userId) {
+        if (!checkCallingPermission(android.Manifest.permission.STATUS_BAR_SERVICE,
+                "setRecordingSecureOverride()")) {
+            throw new SecurityException("Requires STATUS_BAR_SERVICE permission");
+        }
+        final long origId = Binder.clearCallingIdentity();
+        try {
+            synchronized (mGlobalLock) {
+                if (packages == null) {
+                    // A finished recording mustn't end a newer one's override
+                    if (token == mRecordingSecureOverrideToken) {
+                        clearRecordingSecureOverrideLocked();
+                    }
+                    return;
+                }
+                clearRecordingSecureOverrideLocked();
+                final ArraySet<String> allowed = new ArraySet<>(packages);
+                // SystemUI owns the bouncer and the lock screen, which stay protected
+                allowed.remove("android");
+                allowed.remove("com.android.systemui");
+                if (allowed.isEmpty()) {
+                    return;
+                }
+                final IBinder.DeathRecipient death = () -> {
+                    synchronized (mGlobalLock) {
+                        if (token == mRecordingSecureOverrideToken) {
+                            clearRecordingSecureOverrideLocked();
+                        }
+                    }
+                };
+                try {
+                    token.linkToDeath(death, 0);
+                } catch (RemoteException e) {
+                    return;
+                }
+                mRecordingSecureOverrideToken = token;
+                mRecordingSecureOverrideDeath = death;
+                mRecordingSecureOverridePackages = allowed;
+                mRecordingSecureOverrideUser = userId;
+                mRoot.refreshSecureSurfaceState();
+            }
+        } finally {
+            Binder.restoreCallingIdentity(origId);
+        }
+    }
+
+    private void clearRecordingSecureOverrideLocked() {
+        if (mRecordingSecureOverrideToken == null) {
+            return;
+        }
+        mRecordingSecureOverrideToken.unlinkToDeath(mRecordingSecureOverrideDeath, 0);
+        mRecordingSecureOverrideToken = null;
+        mRecordingSecureOverrideDeath = null;
+        mRecordingSecureOverridePackages = null;
+        mRoot.refreshSecureSurfaceState();
+    }
+
+    boolean isRecordingSecureOverrideLocked(String packageName, int userId) {
+        return mRecordingSecureOverridePackages != null
+                && userId == mRecordingSecureOverrideUser
+                && mRecordingSecureOverridePackages.contains(packageName);
+    }
+
     boolean getDisableSecureWindows() {
         return mDisableSecureWindows;
     }
