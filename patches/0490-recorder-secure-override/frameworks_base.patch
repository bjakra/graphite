+package com.android.systemui.screenrecord
+
+import android.content.Context
+import android.os.IBinder
+import android.os.RemoteException
+import android.provider.Settings
+import android.util.Log
+import android.view.WindowManagerGlobal
+import com.android.systemui.screenshot.GraphiteSecureOverride
+
+/**
+ * Graphite: lets SystemUI's screen recorder include the apps on the screenshot override list.
+ * WindowManager clears the secure bit of those apps' windows only, for as long as the recording
+ * runs. A change to the list applies from the next recording.
+ */
+object GraphiteRecorderOverride {
+    private const val TAG = "GraphiteRecorderOverride"
+
+    @JvmStatic
+    fun begin(context: Context, token: IBinder) {
+        val packages =
+            Settings.Secure.getStringForUser(
+                    context.contentResolver,
+                    GraphiteSecureOverride.PACKAGES,
+                    context.userId,
+                )
+                ?.split(',')
+                ?.map { it.trim() }
+                ?.filter { it.isNotEmpty() }
+                .orEmpty()
+        if (packages.isEmpty()) return
+        call { it.setRecordingSecureOverride(token, packages.toTypedArray(), context.userId) }
+    }
+
+    @JvmStatic
+    fun end(token: IBinder) {
+        call { it.setRecordingSecureOverride(token, null, 0) }
+    }
+
+    private fun call(block: (android.view.IWindowManager) -> Unit) {
+        try {
+            WindowManagerGlobal.getWindowManagerService()?.let(block)
+        } catch (e: RemoteException) {
+            Log.w(TAG, "WindowManager is unavailable", e)
+        }
+    }
+}
