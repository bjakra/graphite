+package com.android.systemui.statusbar.pipeline.shared.ui.binder
+
+import android.database.ContentObserver
+import android.os.Handler
+import android.os.Looper
+import android.os.UserHandle
+import android.provider.Settings
+import android.view.View
+
+/** Graphite: optionally hides the status bar's notification icons, which sit beside the cutout. */
+object GraphiteHideNotificationIcons {
+    private const val SETTING = "graphite_hide_notification_icons"
+
+    @JvmStatic
+    fun bind(area: View) {
+        val resolver = area.context.contentResolver
+        fun update() {
+            val hide = Settings.Secure.getIntForUser(resolver, SETTING, 0, UserHandle.USER_CURRENT)
+            area.visibility = if (hide == 1) View.GONE else View.VISIBLE
+        }
+        val observer =
+            object : ContentObserver(Handler(Looper.getMainLooper())) {
+                override fun onChange(selfChange: Boolean) = update()
+            }
+        area.addOnAttachStateChangeListener(
+            object : View.OnAttachStateChangeListener {
+                override fun onViewAttachedToWindow(v: View) {
+                    resolver.registerContentObserver(
+                        Settings.Secure.getUriFor(SETTING),
+                        false,
+                        observer,
+                        UserHandle.USER_ALL,
+                    )
+                    update()
+                }
+
+                override fun onViewDetachedFromWindow(v: View) {
+                    resolver.unregisterContentObserver(observer)
+                }
+            }
+        )
+        update()
+    }
+}
