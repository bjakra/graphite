+package com.android.keyguard
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.database.ContentObserver
+import android.net.Uri
+import android.os.Bundle
+import android.os.Handler
+import android.util.Log
+import com.android.systemui.plugins.keyguard.data.model.WeatherData
+import java.util.concurrent.Executor
+
+/**
+ * Graphite: gives the lock screen clocks weather from the GraphiteWeather app. On stock Pixels this
+ * comes through smartspace, whose session SystemUI only starts with Google's data plugin.
+ */
+internal class GraphiteWeather(
+    private val context: Context,
+    private val handler: Handler,
+    private val backgroundExecutor: Executor,
+    private val send: (WeatherData) -> Unit,
+) {
+    fun start() {
+        context.contentResolver.registerContentObserver(
+            URI,
+            false,
+            object : ContentObserver(handler) {
+                override fun onChange(selfChange: Boolean) = load()
+            },
+        )
+        // The app's storage is only available after the first unlock
+        context.registerReceiver(
+            object : BroadcastReceiver() {
+                override fun onReceive(context: Context, intent: Intent) = load()
+            },
+            IntentFilter(Intent.ACTION_USER_UNLOCKED),
+            null,
+            handler,
+            Context.RECEIVER_NOT_EXPORTED,
+        )
+        load()
+    }
+
+    private fun load() {
+        backgroundExecutor.execute {
+            val data =
+                try {
+                    read()
+                } catch (e: RuntimeException) {
+                    Log.w(TAG, "Couldn't read the weather", e)
+                    return@execute
+                }
+            handler.post { send(data ?: NO_WEATHER) }
+        }
+    }
+
+    private fun read(): WeatherData? =
+        context.contentResolver.query(URI, null, null, null, null)?.use { cursor ->
+            if (!cursor.moveToFirst()) return@use null
+            WeatherData.fromBundle(
+                Bundle().apply {
+                    putString("description", cursor.getString(0))
+                    putInt("state", cursor.getInt(1))
+                    putBoolean("use_celsius", cursor.getInt(2) == 1)
+                    // WeatherData.fromBundle reads this one as a string
+                    putString("temperature", cursor.getInt(3).toString())
+                }
+            )
+        }
+
+    private companion object {
+        const val TAG = "GraphiteWeather"
+        val URI: Uri = Uri.parse("content://org.graphite.weather.data/current")
+        val NO_WEATHER =
+            WeatherData("", WeatherData.WeatherStateIcon.UNKNOWN_ICON, useCelsius = true, temperature = 0)
+    }
+}
diff --git a/packages/SystemUI/src/com/android/keyguard/KeyguardUpdateMonitor.java b/packages/SystemUI/src/com/android/keyguard/KeyguardUpdateMonitor.java
index 93642b94308435e1a4946ad498df027d1818bc48..20617dd9c2a910b4ce2d90995d34fe9cc60244e6 100644
--- a/packages/SystemUI/src/com/android/keyguard/KeyguardUpdateMonitor.java
+++ b/packages/SystemUI/src/com/android/keyguard/KeyguardUpdateMonitor.java
@@ -2562,6 +2562,12 @@ public class KeyguardUpdateMonitor implements TrustManager.TrustListener, CoreSt
                                 Settings.System.TIME_12_24)));
             }
         };
+
+        // Graphite: weather for the lock screen clocks from the GraphiteWeather app
+        new GraphiteWeather(mContext, mHandler, mBackgroundExecutor, data -> {
+            sendWeatherData(data);
+            return kotlin.Unit.INSTANCE;
+        }).start();
     }
 
     private final DreamOverlayCallbackController.Callback mDreamOverlayCallback =
From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bjarne <87858321+bjakra@users.noreply.github.com>
Date: Mon, 2 Nov 2026 19:19:26 +0100
Subject: [PATCH] SystemUI: don't send an empty weather reading

It made the clock show 0 degrees while weather is off.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

---
 .../SystemUI/src/com/android/keyguard/GraphiteWeather.kt    | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/packages/SystemUI/src/com/android/keyguard/GraphiteWeather.kt b/packages/SystemUI/src/com/android/keyguard/GraphiteWeather.kt
index 575234df45c2a81e4417b10241b819566076e39e..66a53a4a306af197f9c3b79470a11e3325488ba9 100644
--- a/packages/SystemUI/src/com/android/keyguard/GraphiteWeather.kt
+++ b/packages/SystemUI/src/com/android/keyguard/GraphiteWeather.kt
@@ -68,7 +68,9 @@ internal class GraphiteWeather(
                     Log.w(TAG, "Couldn't read the weather", e)
                     return@execute
                 }
-            handler.post { send(data ?: NO_WEATHER) }
+            // Like upstream, there's no way to clear it, so the last reading stays until the next
+            // restart. Sending an empty value would make the clock show 0 degrees.
+            if (data != null) handler.post { send(data) }
         }
     }
 
@@ -89,7 +91,5 @@ internal class GraphiteWeather(
     private companion object {
         const val TAG = "GraphiteWeather"
         val URI: Uri = Uri.parse("content://org.graphite.weather.data/current")
-        val NO_WEATHER =
-            WeatherData("", WeatherData.WeatherStateIcon.UNKNOWN_ICON, useCelsius = true, temperature = 0)
     }
 }
