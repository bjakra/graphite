+++ b/src/app/grapheneos/gmscompat/keybox/IKeyboxImportService.aidl
@@ -0,0 +1,16 @@
+// Delivered by the graphite_parts mirror resolver (patch 0661). The service validates
+// delivered XML with the same PlayKeybox.parse path as a manual import before storing it;
+// this file carries data only, never code.
+package app.grapheneos.gmscompat.keybox;
+
+interface IKeyboxImportService {
+    /**
+     * Validates and stores [xml], like a manual import on KeyboxActivity. The enabled state of the
+     * keybox is deliberately not touched (rotation only refreshes the stored box).
+     *
+     * Returns the earliest certificate expiry as epoch millis, or -1 when the box was rejected or
+     * storing failed, with [detail][0] holding a short reason. [provenance] is a short label of
+     * where the box came from (see KeyboxStore.setProvenance), or null to keep it unknown.
+     */
+    long importKeybox(in byte[] xml, in @nullable String provenance, out String[] detail);
+}
diff --git a/src/app/grapheneos/gmscompat/keybox/KeyboxImportService.kt b/src/app/grapheneos/gmscompat/keybox/KeyboxImportService.kt
new file mode 100644
index 0000000000000000000000000000000000000000..6d855d29c7d9328a1f041602229dde9c56f5f938
--- /dev/null
+++ b/src/app/grapheneos/gmscompat/keybox/KeyboxImportService.kt
@@ -0,0 +1,46 @@
+package app.grapheneos.gmscompat.keybox
+
+import android.app.Service
+import android.content.Intent
+import android.os.IBinder
+import android.util.Log
+
+/**
+ * Delivery endpoint for Graphite settings' community keybox mirror resolver (patch 0661, resolver
+ * lives in graphite_parts). Exported to that app only: the manifest guards it with
+ * org.graphite.parts.permission.IMPORT_KEYBOX, defined platform-signed by GraphiteParts.
+ *
+ * Delivered XML is data: it runs the same PlayKeybox.parse validation as a manual import on
+ * KeyboxActivity. Nothing else changes (the enabled switch stays as the user set it), and the
+ * private key stays in the box file inside this process, exactly like any manual import.
+ */
+class KeyboxImportService : Service() {
+    private val binder = object : IKeyboxImportService.Stub() {
+        override fun importKeybox(xml: ByteArray?, provenance: String?, detail: Array<String>?): Long {
+            if (xml == null || detail == null) return reject(detail, "invalid-request")
+            val proven =
+                provenance?.replace('\n', ' ')?.replace('\r', ' ')?.takeIf { it.isNotBlank() }
+            // provenance is odd trivia, but keep it printable, short and free of caller's newlines.
+            Log.d(TAG, "keybox delivery from ${proven?.take(40)?.let { it + "…" } ?: "unknown source"}")
+            return try {
+                val state = KeyboxStore.importKeybox(xml, proven)
+                detail[0] = "imported"
+                state.earliestExpiry?.time ?: -1L
+            } catch (e: Exception) {
+                Log.w(TAG, "Rejected delivered keybox: ${e.javaClass.simpleName}")
+                reject(detail, "invalid: ${e.javaClass.simpleName}")
+            }
+        }
+    }
+
+    private fun reject(detail: Array<String>?, reason: String): Long {
+        detail?.let { it[0] = reason }
+        return -1L
+    }
+
+    override fun onBind(intent: Intent?): IBinder = binder
+
+    companion object {
+        private const val TAG = "PlayKeyboxImport"
+    }
+}
