     private fun bootcfgFile() = File(ctx.noBackupFilesDir, BOOTCFG_FILE)
+    private fun provenanceFile() = File(ctx.noBackupFilesDir, PROVENANCE_FILE)
 
     private fun isUserUnlocked(): Boolean {
         return ctx.getSystemService(UserManager::class.java)?.isUserUnlocked == true
@@ -78,6 +84,8 @@ object KeyboxStore {
         loaded = true
         enabled = runCatching { enabledFile().readText() == "1" }.getOrDefault(false)
         bootCfg = runCatching { parseBootCfg(bootcfgFile().readText()) }.getOrDefault(DEFAULT_BOOT_CONFIG)
+        provenance = provenanceFile().takeIf { it.isFile }
+            ?.let { runCatching { it.readText() }.getOrNull()?.takeIf { t -> t.isNotBlank() } }
         parsed = if (keyboxFile().isFile) {
             try {
                 // Expiry is checked when the feature is used, not treated as file corruption.
@@ -103,6 +111,7 @@ object KeyboxStore {
             usable = usable,
             algorithms = current?.algorithms,
             earliestExpiry = current?.earliestExpiry,
+            provenance = provenance,
         )
     }
 
@@ -119,12 +128,22 @@ object KeyboxStore {
     }
 
     /** Validates first; malformed input never replaces the existing keybox or changes the switch. */
-    fun importKeybox(xml: ByteArray): KeyboxState = synchronized(lock) {
+    fun importKeybox(xml: ByteArray, provenance: String? = null): KeyboxState = synchronized(lock) {
         ensureLoadedLocked()
         val newParsed = PlayKeybox.parse(xml)
         // AtomicFile preserves the old file on failure. The enabled setting is deliberately not
         // touched, so there is no two-file transaction to roll back.
         writeAtomic(keyboxFile(), xml)
+        // Only after a successful import: record where the box came from for the status row.
+        runCatching {
+            if (provenance.isNullOrBlank()) {
+                AtomicFile(provenanceFile()).delete()
+                this.provenance = null
+            } else {
+                writeAtomic(provenanceFile(), provenance.toByteArray())
+                this.provenance = provenance
+            }
+        }
         parsed = newParsed
         loaded = true
         state()
@@ -141,6 +160,7 @@ object KeyboxStore {
         AtomicFile(keyboxFile()).delete()
         AtomicFile(enabledFile()).delete()
         AtomicFile(bootcfgFile()).delete()
+        AtomicFile(provenanceFile()).delete()
     }
 
     /** The verified boot fields the rewrite reports. Default = Original key/hash, Verified. */
