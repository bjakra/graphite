+/**
+ * Parser and leaf re-signer for a user-supplied Android attestation keybox.
+ *
+ * <p>The parsed representation is immutable and is intended to remain in the GmsCompat app
+ * process. Only re-signed certificate chains are sent back to Play services; the private key is
+ * never sent over Binder.</p>
+ *
+ * @hide
+ */
+public final class PlayKeybox {
+    public static final int MAX_XML_BYTES = 64 * 1024;
+    public static final String ATTESTATION_EXTENSION_OID = "1.3.6.1.4.1.11129.2.1.17";
+
+    private static final Pattern BASE64 = Pattern.compile("[A-Za-z0-9+/]*={0,2}");
+
+    private PlayKeybox() {}
+
+    /** An immutable, fully validated keybox. */
+    public static final class ParsedKeybox {
+        private final Map<String, Keybox> keyboxes;
+        private final String algorithms;
+        private final Date earliestExpiry;
+
+        private ParsedKeybox(Map<String, Keybox> keyboxes) {
+            this.keyboxes = Collections.unmodifiableMap(new LinkedHashMap<>(keyboxes));
+            long expiry = Long.MAX_VALUE;
+            for (Keybox keybox : keyboxes.values()) {
+                for (X509Certificate certificate : keybox.certificates) {
+                    expiry = Math.min(expiry, certificate.getNotAfter().getTime());
+                }
+            }
+            earliestExpiry = new Date(expiry);
+            algorithms = String.join(", ", keyboxes.keySet());
+        }
+
+        public String getAlgorithms() {
+            return algorithms;
+        }
+
+        public Date getEarliestExpiry() {
+            return new Date(earliestExpiry.getTime());
+        }
+
+        public boolean isValidNow() {
+            Date now = new Date();
+            for (Keybox keybox : keyboxes.values()) {
+                if (!keybox.isValid(now)) return false;
+            }
+            return true;
+        }
+
+        /**
+         * Re-signs an attested leaf and appends the matching keybox chain. All leaf fields,
+         * including its public key and attestation extension, are preserved.
+         *
+         * @return a replacement chain, the input chain if already signed by this keybox, or null
+         *         if the input is not an Android key-attestation chain
+         */
+        public Certificate[] maybeRewrite(Certificate[] chain) throws Exception {
+            if (chain == null || chain.length < 2 || !(chain[0] instanceof X509Certificate)) {
+                return null;
+            }
+            X509Certificate leaf = (X509Certificate) chain[0];
+            if (leaf.getExtensionValue(ATTESTATION_EXTENSION_OID) == null) {
+                return null;
+            }
+
+            String subjectAlgorithm = leaf.getPublicKey().getAlgorithm();
+            Keybox keybox = keyboxes.get(normalizeAlgorithm(subjectAlgorithm));
+            if (keybox == null) {
+                String alternate = "EC".equalsIgnoreCase(subjectAlgorithm) ? "RSA" : "EC";
+                keybox = keyboxes.get(alternate);
+            }
+            if (keybox == null || !keybox.isValid(new Date())) {
+                return null;
+            }
+
+            X509Certificate issuer = keybox.certificates.get(0);
+            if (chain[1] instanceof X509Certificate
+                    && Arrays.equals(chain[1].getEncoded(), issuer.getEncoded())) {
+                try {
+                    leaf.verify(issuer.getPublicKey());
+                    return chain;
+                } catch (GeneralSecurityException ignored) {
+                    // The issuer name matches but the signature does not; replace the leaf.
+                }
+            }
+
+            X509CertificateHolder leafHolder = new X509CertificateHolder(leaf.getEncoded());
+            X500Name issuerName = new X509CertificateHolder(issuer.getEncoded()).getSubject();
+            X509v3CertificateBuilder builder = new X509v3CertificateBuilder(
+                    issuerName,
+                    leafHolder.getSerialNumber(),
+                    leafHolder.getNotBefore(),
+                    leafHolder.getNotAfter(),
+                    leafHolder.getSubject(),
+                    leafHolder.getSubjectPublicKeyInfo());
+            for (Object oid : leafHolder.getExtensions().getExtensionOIDs()) {
+                builder.addExtension(leafHolder.getExtension(
+                        new ASN1ObjectIdentifier(oid.toString())));
+            }
+
+            String signatureAlgorithm = signatureAlgorithm(keybox.privateKey.getAlgorithm());
+            ContentSigner signer = new JcaContentSigner(signatureAlgorithm, keybox.privateKey);
+            X509CertificateHolder replacement = builder.build(signer);
+            CertificateFactory factory = CertificateFactory.getInstance("X.509");
+            X509Certificate replacementLeaf = (X509Certificate) factory.generateCertificate(
+                    new ByteArrayInputStream(replacement.getEncoded()));
+            replacementLeaf.verify(issuer.getPublicKey());
+
+            Certificate[] result = new Certificate[keybox.certificates.size() + 1];
+            result[0] = replacementLeaf;
+            for (int i = 0; i < keybox.certificates.size(); i++) {
+                result[i + 1] = keybox.certificates.get(i);
+            }
+            return result;
+        }
+    }
+
+    private static final class Keybox {
+        final PrivateKey privateKey;
+        final List<X509Certificate> certificates;
+
+        Keybox(PrivateKey privateKey, List<X509Certificate> certificates) {
+            this.privateKey = privateKey;
+            this.certificates = certificates;
+        }
+
+        boolean isValid(Date now) {
+            for (X509Certificate certificate : certificates) {
+                if (now.before(certificate.getNotBefore()) || now.after(certificate.getNotAfter())) {
+                    return false;
+                }
+            }
+            return true;
+        }
+    }
+
+    /** Parses and validates all key blocks before publishing an immutable result. */
+    public static ParsedKeybox parse(byte[] xmlBytes) throws Exception {
+        return parse(xmlBytes, true);
+    }
+
+    /** Parses stored data without deleting it merely because its validity dates have passed. */
+    public static ParsedKeybox parseStored(byte[] xmlBytes) throws Exception {
+        return parse(xmlBytes, false);
+    }
+
+    private static ParsedKeybox parse(byte[] xmlBytes, boolean checkValidity) throws Exception {
+        if (xmlBytes == null || xmlBytes.length == 0 || xmlBytes.length > MAX_XML_BYTES) {
+            throw new IllegalArgumentException("Keybox must contain between 1 and "
+                    + MAX_XML_BYTES + " bytes");
+        }
+        String xml = StandardCharsets.UTF_8.newDecoder()
+                .onMalformedInput(java.nio.charset.CodingErrorAction.REPORT)
+                .onUnmappableCharacter(java.nio.charset.CodingErrorAction.REPORT)
+                .decode(java.nio.ByteBuffer.wrap(xmlBytes)).toString();
+        if (xml.startsWith("\uFEFF")) xml = xml.substring(1);
+        Map<String, Keybox> result = new LinkedHashMap<>();
+
+        XmlPullParserFactory factory = XmlPullParserFactory.newInstance();
+        factory.setFeature(XmlPullParser.FEATURE_PROCESS_DOCDECL, false);
+        XmlPullParser parser = factory.newPullParser();
+        parser.setFeature(XmlPullParser.FEATURE_PROCESS_NAMESPACES, false);
+        parser.setInput(new StringReader(xml));
+
+        boolean sawRoot = false;
+        boolean rootClosed = false;
+        boolean sawNumber = false;
+        boolean sawAnyKeybox = false;
+        boolean inKeybox = false;
+        boolean inKey = false;
+        boolean inCertificateChain = false;
+        boolean sawPrivateKey = false;
+        boolean sawCertificateChain = false;
+        int keysInBox = 0;
+        String algorithm = null;
+        String privateKeyPem = null;
+        List<String> certificates = new ArrayList<>();
+        StringBuilder text = null;
+        StringBuilder numberText = null;
+
+        int event = parser.getEventType();
+        while (event != XmlPullParser.END_DOCUMENT) {
+            String name = parser.getName();
+            int depth = parser.getDepth();
+            switch (event) {
+                case XmlPullParser.START_TAG:
+                    if (depth == 1) {
+                        require(sawRoot == false && "AndroidAttestation".equals(name));
+                        sawRoot = true;
+                    } else if (depth == 2 && "Keybox".equals(name)) {
+                        require(sawRoot && !inKeybox);
+                        inKeybox = true;
+                        sawAnyKeybox = true;
+                        keysInBox = 0;
+                    } else if (depth == 2 && "NumberOfKeyboxes".equals(name)) {
+                        require(!sawAnyKeybox && !sawNumber);
+                        sawNumber = true;
+                        numberText = new StringBuilder();
+                    } else if (depth == 3 && "Key".equals(name)) {
+                        require(inKeybox && !inKey);
+                        inKey = true;
+                        keysInBox++;
+                        algorithm = parser.getAttributeValue(null, "algorithm");
+                        privateKeyPem = null;
+                        certificates.clear();
+                        sawPrivateKey = false;
+                        sawCertificateChain = false;
+                    } else if (depth == 4 && "PrivateKey".equals(name)) {
+                        require(inKey && !sawPrivateKey && !sawCertificateChain);
+                        sawPrivateKey = true;
+                        text = new StringBuilder();
+                    } else if (depth == 4 && "CertificateChain".equals(name)) {
+                        require(inKey && sawPrivateKey && !sawCertificateChain);
+                        sawCertificateChain = true;
+                        inCertificateChain = true;
+                    } else if (depth == 5 && "NumberOfCertificates".equals(name)) {
+                        require(inCertificateChain && certificates.isEmpty() && text == null);
+                        numberText = new StringBuilder();
+                    } else if (depth == 5 && "Certificate".equals(name)) {
+                        require(inCertificateChain && text == null);
+                        text = new StringBuilder();
+                    } else {
+                        throw new IllegalArgumentException("Unexpected XML element");
+                    }
+                    checkAttributes(parser, name);
+                    break;
+                case XmlPullParser.TEXT:
+                case XmlPullParser.CDSECT:
+                case XmlPullParser.IGNORABLE_WHITESPACE:
+                    if (text != null) {
+                        text.append(parser.getText());
+                    } else if (numberText != null) {
+                        numberText.append(parser.getText());
+                    } else if (!parser.isWhitespace()) {
+                        throw new IllegalArgumentException("Unexpected XML text");
+                    }
+                    break;
+                case XmlPullParser.END_TAG:
+                    if (depth == 5 && "Certificate".equals(name)) {
+                        require(inCertificateChain && text != null);
+                        certificates.add(text.toString().trim());
+                        text = null;
+                    } else if (depth == 4 && "PrivateKey".equals(name)) {
+                        require(sawPrivateKey && text != null);
+                        privateKeyPem = text.toString().trim();
+                        text = null;
+                    } else if (depth == 4 && "CertificateChain".equals(name)) {
+                        require(inCertificateChain && !certificates.isEmpty());
+                        inCertificateChain = false;
+                    } else if (depth == 3 && "Key".equals(name)) {
+                        require(inKey && sawPrivateKey && sawCertificateChain
+                                && !inCertificateChain && privateKeyPem != null
+                                && !privateKeyPem.isEmpty() && !certificates.isEmpty());
+                        Keybox keybox = parseKey(algorithm, privateKeyPem, certificates,
+                                checkValidity);
+                        String normalized = normalizeAlgorithm(algorithm);
+                        if (result.put(normalized, keybox) != null) {
+                            throw new IllegalArgumentException("Duplicate " + normalized + " key");
+                        }
+                        inKey = false;
+                        algorithm = null;
+                    } else if (depth == 2 && "Keybox".equals(name)) {
+                        require(inKeybox && !inKey && keysInBox > 0);
+                        inKeybox = false;
+                    } else if ((depth == 2 && "NumberOfKeyboxes".equals(name))
+                            || (depth == 5 && "NumberOfCertificates".equals(name))) {
+                        // Advisory counts, as in other keybox parsers: checked for syntax only.
+                        require(numberText != null);
+                        int declared = Integer.parseInt(numberText.toString().trim());
+                        require(declared >= 0);
+                        numberText = null;
+                    } else if (depth == 1 && "AndroidAttestation".equals(name)) {
+                        require(sawRoot && !inKeybox && !inKey && !result.isEmpty());
+                        rootClosed = true;
+                    } else {
+                        throw new IllegalArgumentException("Unexpected XML end element");
+                    }
+                    break;
+                case XmlPullParser.START_DOCUMENT:
+                case XmlPullParser.COMMENT:
+                    break;
+                default:
+                    throw new IllegalArgumentException("Unexpected XML content");
+            }
+            event = parser.next();
+        }
+        require(sawRoot && rootClosed && !inKeybox && !inKey && !result.isEmpty());
+        return new ParsedKeybox(result);
+    }
+
+    private static void require(boolean condition) {
+        if (!condition) throw new IllegalArgumentException("Invalid keybox XML structure");
+    }
+
+    /**
+     * Attributes of the common keybox format: Key needs "algorithm", Keybox may name a
+     * "DeviceID", PrivateKey and Certificate may say format="pem". Anything else is rejected.
+     */
+    private static void checkAttributes(XmlPullParser parser, String element) {
+        boolean sawAlgorithm = false;
+        for (int i = 0; i < parser.getAttributeCount(); i++) {
+            String attribute = parser.getAttributeName(i);
+            String value = parser.getAttributeValue(i);
+            if ("Key".equals(element) && "algorithm".equals(attribute)) {
+                sawAlgorithm = true;
+            } else if ("Keybox".equals(element) && "DeviceID".equals(attribute)) {
+                // Informational only.
+            } else if (("PrivateKey".equals(element) || "Certificate".equals(element))
+                    && "format".equals(attribute)) {
+                require("pem".equalsIgnoreCase(value));
+            } else {
+                throw new IllegalArgumentException("Unexpected XML attribute");
+            }
+        }
+        require(!"Key".equals(element) || sawAlgorithm);
+    }
+
+    private static Keybox parseKey(String algorithm, String privateKeyPem,
+            List<String> certificatePems, boolean checkValidity) throws Exception {
+        String normalized = normalizeAlgorithm(algorithm);
+        PrivateKey privateKey = parsePrivateKey(privateKeyPem, normalized);
+        CertificateFactory factory = CertificateFactory.getInstance("X.509");
+        List<X509Certificate> certificates = new ArrayList<>();
+        for (String pem : certificatePems) {
+            PemData data = parsePemContent(pem);
+            require(data.type == null || "CERTIFICATE".equals(data.type));
+            byte[] der = data.bytes;
+            readSingleAsn1(der);
+            certificates.add((X509Certificate) factory.generateCertificate(
+                    new ByteArrayInputStream(der)));
+        }
+        List<X509Certificate> ordered = orderChain(privateKey, normalized, certificates);
+        for (int i = 0; i < ordered.size(); i++) {
+            X509Certificate certificate = ordered.get(i);
+            if (checkValidity) certificate.checkValidity();
+            if (i + 1 < ordered.size()) {
+                X509Certificate issuer = ordered.get(i + 1);
+                if (!certificate.getIssuerX500Principal().equals(issuer.getSubjectX500Principal())) {
+                    throw new CertificateException("Certificate issuer mismatch");
+                }
+                certificate.verify(issuer.getPublicKey());
+            } else if (certificate.getSubjectX500Principal().equals(
+                    certificate.getIssuerX500Principal())) {
+                certificate.verify(certificate.getPublicKey());
+            }
+        }
+        return new Keybox(privateKey, Collections.unmodifiableList(ordered));
+    }
+
+    private static List<X509Certificate> orderChain(PrivateKey privateKey, String algorithm,
+            List<X509Certificate> input) throws Exception {
+        List<X509Certificate> unique = new ArrayList<>();
+        for (X509Certificate candidate : input) {
+            boolean duplicate = false;
+            for (X509Certificate existing : unique) {
+                if (Arrays.equals(existing.getEncoded(), candidate.getEncoded())) {
+                    duplicate = true;
+                    break;
+                }
+            }
+            if (!duplicate) unique.add(candidate);
+        }
+
+        X509Certificate leaf = null;
+        for (X509Certificate candidate : unique) {
+            if (!algorithm.equalsIgnoreCase(candidate.getPublicKey().getAlgorithm())) continue;
+            try {
+                verifyPrivateKey(privateKey, candidate.getPublicKey(), algorithm);
+            } catch (GeneralSecurityException ignored) {
+                continue;
+            }
+            if (leaf != null) throw new CertificateException("Ambiguous private key match");
+            leaf = candidate;
+        }
+        if (leaf == null) {
+            throw new CertificateException("No certificate matches the private key");
+        }
+
+        List<X509Certificate> ordered = new ArrayList<>();
+        List<X509Certificate> remaining = new ArrayList<>(unique);
+        X509Certificate current = leaf;
+        while (true) {
+            ordered.add(current);
+            remaining.remove(current);
+            if (current.getIssuerX500Principal().equals(current.getSubjectX500Principal())) {
+                try {
+                    current.verify(current.getPublicKey());
+                    break;
+                } catch (GeneralSecurityException ignored) {
+                    // A self-issued certificate can also be cross-signed.
+                }
+            }
+            X509Certificate next = null;
+            for (X509Certificate candidate : remaining) {
+                if (!current.getIssuerX500Principal().equals(candidate.getSubjectX500Principal())) {
+                    continue;
+                }
+                try {
+                    current.verify(candidate.getPublicKey());
+                } catch (GeneralSecurityException ignored) {
+                    continue;
+                }
+                if (next != null) throw new CertificateException("Ambiguous issuer certificate");
+                next = candidate;
+            }
+            if (next == null) {
+                throw new CertificateException("Incomplete certificate chain: no verified root");
+            }
+            current = next;
+        }
+        if (!remaining.isEmpty()) {
+            throw new CertificateException("Disconnected certificate chain");
+        }
+        return ordered;
+    }
+
+    private static void verifyPrivateKey(PrivateKey privateKey, PublicKey publicKey,
+            String algorithm) throws GeneralSecurityException {
+        byte[] challenge = new byte[32];
+        new SecureRandom().nextBytes(challenge);
+        String signatureAlgorithm = signatureAlgorithm(algorithm);
+        Signature signer = Signature.getInstance(signatureAlgorithm);
+        signer.initSign(privateKey);
+        signer.update(challenge);
+        byte[] signature = signer.sign();
+        Signature verifier = Signature.getInstance(signatureAlgorithm);
+        verifier.initVerify(publicKey);
+        verifier.update(challenge);
+        if (!verifier.verify(signature)) {
+            throw new GeneralSecurityException("Private key does not match certificate");
+        }
+    }
+
+    private static PrivateKey parsePrivateKey(String pem, String algorithm) throws Exception {
+        PemData data = parsePemContent(pem);
+        String pemType = data.type;
+        if ("EC".equals(algorithm)) {
+            require(pemType == null || "EC PRIVATE KEY".equals(pemType)
+                    || "PRIVATE KEY".equals(pemType));
+            if (!"PRIVATE KEY".equals(pemType)) {
+                return parseEcPrivateKey(data.bytes, pemType == null);
+            }
+        } else {
+            require(pemType == null || "RSA PRIVATE KEY".equals(pemType)
+                    || "PRIVATE KEY".equals(pemType));
+            if (!"PRIVATE KEY".equals(pemType)) {
+                return parseRsaPrivateKey(data.bytes, pemType == null);
+            }
+        }
+
+        return pkcs8PrivateKey(algorithm, readSingleAsn1(data.bytes));
+    }
+
+    // Keys are normalized to PKCS#8 and handed to the platform provider (Conscrypt): the
+    // platform's repackaged BouncyCastle provider doesn't register ECDSA signatures.
+    private static PrivateKey pkcs8PrivateKey(String algorithm, ASN1Primitive primitive)
+            throws Exception {
+        PrivateKeyInfo info = PrivateKeyInfo.getInstance(primitive);
+        return KeyFactory.getInstance(algorithm).generatePrivate(
+                new PKCS8EncodedKeySpec(info.getEncoded()));
+    }
+
+    private static PrivateKey parseEcPrivateKey(byte[] keyBytes,
+            boolean allowPkcs8Fallback) throws Exception {
+        ASN1Primitive primitive = readSingleAsn1(keyBytes);
+        ECPrivateKey key;
+        try {
+            key = ECPrivateKey.getInstance(primitive);
+            key.getKey();
+        } catch (Exception e) {
+            if (!allowPkcs8Fallback) throw e;
+            return pkcs8PrivateKey("EC", primitive);
+        }
+        // SEC1 keys must name their curve; explicit curve parameters are not accepted.
+        ASN1ObjectIdentifier curve;
+        try {
+            curve = ASN1ObjectIdentifier.getInstance(key.getParameters());
+        } catch (RuntimeException e) {
+            curve = null; // getParameters() throws when the optional field is absent
+        }
+        if (curve == null) throw new GeneralSecurityException("EC key without named curve");
+        PrivateKeyInfo info = new PrivateKeyInfo(
+                new AlgorithmIdentifier(X9ObjectIdentifiers.id_ecPublicKey, curve), key);
+        return KeyFactory.getInstance("EC").generatePrivate(
+                new PKCS8EncodedKeySpec(info.getEncoded()));
+    }
+
+    private static PrivateKey parseRsaPrivateKey(byte[] keyBytes,
+            boolean allowPkcs8Fallback) throws Exception {
+        ASN1Primitive primitive = readSingleAsn1(keyBytes);
+        RSAPrivateKey key;
+        try {
+            key = RSAPrivateKey.getInstance(primitive);
+        } catch (Exception e) {
+            if (!allowPkcs8Fallback) throw e;
+            return pkcs8PrivateKey("RSA", primitive);
+        }
+        return KeyFactory.getInstance("RSA").generatePrivate(new RSAPrivateCrtKeySpec(
+                key.getModulus(), key.getPublicExponent(), key.getPrivateExponent(),
+                key.getPrime1(), key.getPrime2(), key.getExponent1(), key.getExponent2(),
+                key.getCoefficient()));
+    }
+
+    private static ASN1Primitive readSingleAsn1(byte[] der) throws IOException {
+        try (ASN1InputStream input = new ASN1InputStream(der)) {
+            ASN1Primitive result = input.readObject();
+            if (result == null || input.readObject() != null) {
+                throw new IOException("Expected exactly one DER object");
+            }
+            return result;
+        }
+    }
+
+    private static String normalizeAlgorithm(String algorithm) {
+        if (algorithm == null) throw new IllegalArgumentException("Missing key algorithm");
+        return switch (algorithm.toLowerCase(Locale.ROOT)) {
+            case "ec", "ecdsa" -> "EC";
+            case "rsa" -> "RSA";
+            default -> throw new IllegalArgumentException("Unsupported key algorithm");
+        };
+    }
+
+    private static String signatureAlgorithm(String algorithm) {
+        if ("EC".equalsIgnoreCase(algorithm)) return "SHA256withECDSA";
+        if ("RSA".equalsIgnoreCase(algorithm)) return "SHA256withRSA";
+        throw new IllegalArgumentException("Unsupported signature algorithm");
+    }
+
+    private static final class PemData {
+        final String type;
+        final byte[] bytes;
+
+        PemData(String type, byte[] bytes) {
+            this.type = type;
+            this.bytes = bytes;
+        }
+    }
+
+    private static PemData parsePemContent(String pem) {
+        String value = pem.trim();
+        String type = null;
+        String body = value;
+        if (value.startsWith("-----BEGIN ")) {
+            int typeEnd = value.indexOf("-----", 11);
+            require(typeEnd > 11);
+            type = value.substring(11, typeEnd);
+            require(type.matches("[A-Z0-9 ]+"));
+            String begin = "-----BEGIN " + type + "-----";
+            String end = "-----END " + type + "-----";
+            require(value.startsWith(begin) && value.endsWith(end));
+            body = value.substring(begin.length(), value.length() - end.length()).trim();
+            require(!body.contains("-----"));
+        } else {
+            require(!value.contains("-----"));
+        }
+        String base64 = body.replaceAll("\\s", "");
+        require(!base64.isEmpty() && BASE64.matcher(base64).matches());
+        return new PemData(type, Base64.getDecoder().decode(base64));
+    }
+
+    /** Encodes a certificate chain as concatenated DER certificates. */
+    public static byte[] encodeChain(Certificate[] chain) throws CertificateException {
+        if (chain == null) return null;
+        try {
+            ByteArrayOutputStream output = new ByteArrayOutputStream();
+            for (Certificate certificate : chain) {
+                output.write(certificate.getEncoded());
+            }
+            return output.toByteArray();
+        } catch (IOException e) {
+            throw new CertificateException("Unable to encode certificate chain", e);
+        }
+    }
+
+    /** Decodes concatenated DER certificates. */
+    public static Certificate[] decodeChain(byte[] encoded) throws CertificateException {
+        if (encoded == null) return null;
+        CertificateFactory factory = CertificateFactory.getInstance("X.509");
+        return factory.generateCertificates(new ByteArrayInputStream(encoded)).toArray(
+                new Certificate[0]);
+    }
+
+    private static final class JcaContentSigner implements ContentSigner {
+        private final AlgorithmIdentifier algorithmIdentifier;
+        private final Signature signature;
+        private final ByteArrayOutputStream output = new ByteArrayOutputStream();
+
+        JcaContentSigner(String algorithm, PrivateKey privateKey) throws GeneralSecurityException {
+            algorithmIdentifier = new DefaultSignatureAlgorithmIdentifierFinder().find(algorithm);
+            signature = Signature.getInstance(algorithm);
+            signature.initSign(privateKey);
+        }
+
+        @Override
+        public AlgorithmIdentifier getAlgorithmIdentifier() {
+            return algorithmIdentifier;
+        }
+
+        @Override
+        public OutputStream getOutputStream() {
+            return output;
+        }
+
+        @Override
+        public byte[] getSignature() {
+            try {
+                byte[] data = output.toByteArray();
+                signature.update(data);
+                return signature.sign();
+            } catch (GeneralSecurityException e) {
+                throw new RuntimeException("Unable to sign certificate", e);
+            }
+        }
+    }
+}
