@@ -0,0 +1,63 @@
+/*
+ * Copyright (C) 2026 The Graphite Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.internal.gmscompat;
+
+import android.app.compat.gms.GmsCompat;
+import android.util.Log;
+
+import java.security.cert.Certificate;
+import java.security.cert.X509Certificate;
+import java.util.Arrays;
+
+/** Client side of the Play-services-only keybox hook. */
+public final class PlayKeyboxHooks {
+    private static final String TAG = "GmsCompat/Keybox";
+
+    private PlayKeyboxHooks() {}
+
+    public static boolean shouldHook() {
+        // PackageId.GMS_CORE is assigned by PackageManager only after Google's signing certificate
+        // is verified. The combined checks exclude privileged GMS and GmsCompat test packages.
+        return GmsCompat.isEnabled() && GmsCompat.isGmsCore();
+    }
+
+    public static Certificate[] maybeRewrite(Certificate[] chain) {
+        if (!shouldHook() || chain == null || chain.length < 2
+                || !(chain[0] instanceof X509Certificate)) {
+            return chain;
+        }
+        X509Certificate leaf = (X509Certificate) chain[0];
+        if (leaf.getExtensionValue(PlayKeybox.ATTESTATION_EXTENSION_OID) == null) {
+            return chain;
+        }
+
+        try {
+            byte[] request = PlayKeybox.encodeChain(chain);
+            byte[] response = GmsCompatApp.call(i -> i.rewriteAttestationChain(request));
+            if (response == null) return chain;
+            Certificate[] replacement = PlayKeybox.decodeChain(response);
+            if (replacement == null || replacement.length < 2
+                    || !(replacement[0] instanceof X509Certificate)) {
+                return chain;
+            }
+            X509Certificate replacementLeaf = (X509Certificate) replacement[0];
+            // Never allow the helper to change which application key is attested or which
+            // KeyMint authorization list is being signed.
+            if (!Arrays.equals(leaf.getPublicKey().getEncoded(),
+                    replacementLeaf.getPublicKey().getEncoded())
+                    || !Arrays.equals(leaf.getExtensionValue(PlayKeybox.ATTESTATION_EXTENSION_OID),
+                    replacementLeaf.getExtensionValue(PlayKeybox.ATTESTATION_EXTENSION_OID))) {
+                Log.w(TAG, "Rejected a chain that changed the application key or attestation");
+                return chain;
+            }
+            return replacement;
+        } catch (Exception e) {
+            // Keybox data and certificates are deliberately not logged.
+            Log.w(TAG, "Chain rewrite failed: " + e.getClass().getSimpleName());
+            return chain;
+        }
+    }
+}
diff --git a/core/tests/coretests/src/com/android/internal/gmscompat/PlayKeyboxTest.java b/core/tests/coretests/src/com/android/internal/gmscompat/PlayKeyboxTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..bc40baef183096ca4270e09fe2e2ce80ad7c2644
--- /dev/null
+++ b/core/tests/coretests/src/com/android/internal/gmscompat/PlayKeyboxTest.java
@@ -0,0 +1,255 @@
+/*
+ * Copyright (C) 2026 The Graphite Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.internal.gmscompat;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.fail;
+
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import androidx.test.filters.SmallTest;
+
+import org.bouncycastle.asn1.ASN1ObjectIdentifier;
+import org.bouncycastle.asn1.DEROctetString;
+import org.bouncycastle.asn1.x500.X500Name;
+import org.bouncycastle.asn1.x509.Extension;
+import org.bouncycastle.asn1.x509.SubjectPublicKeyInfo;
+import org.bouncycastle.cert.X509CertificateHolder;
+import org.bouncycastle.cert.X509v3CertificateBuilder;
+import org.bouncycastle.operator.jcajce.JcaContentSignerBuilder;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import java.io.ByteArrayInputStream;
+import java.math.BigInteger;
+import java.security.KeyPair;
+import java.security.KeyPairGenerator;
+import java.security.PrivateKey;
+import java.security.PublicKey;
+import java.security.cert.Certificate;
+import java.security.cert.CertificateFactory;
+import java.security.cert.X509Certificate;
+import java.time.Instant;
+import java.time.temporal.ChronoUnit;
+import java.util.Arrays;
+import java.util.Base64;
+import java.util.Date;
+
+@SmallTest
+@RunWith(AndroidJUnit4.class)
+public class PlayKeyboxTest {
+    private static long serial = 1;
+
+    @Test
+    public void ecKeyboxReSignsOnlyAttestedLeaf() throws Exception {
+        checkKeybox("EC");
+    }
+
+    @Test
+    public void rsaKeyboxReSignsOnlyAttestedLeaf() throws Exception {
+        checkKeybox("RSA");
+    }
+
+    @Test
+    public void mismatchedPrivateKeyIsRejected() throws Exception {
+        KeyboxMaterial keybox = createKeybox("EC");
+        KeyPair other = keyPair("EC");
+        String xml = xml("ecdsa", other.getPrivate().getEncoded(),
+                new X509Certificate[] { keybox.issuer, keybox.root });
+        try {
+            PlayKeybox.parse(xml.getBytes());
+            fail("Expected key mismatch to be rejected");
+        } catch (Exception expected) {
+            // Expected.
+        }
+    }
+
+    @Test
+    public void malformedInputsAreRejected() throws Exception {
+        KeyboxMaterial keybox = createKeybox("EC");
+        byte[] privateKey = keybox.issuerKey.getPrivate().getEncoded();
+        String valid = xml("ecdsa", privateKey,
+                new X509Certificate[] { keybox.issuer, keybox.root });
+
+        expectRejected(valid.replace("<AndroidAttestation>", "<OtherRoot>")
+                .replace("</AndroidAttestation>", "</OtherRoot>"));
+        expectRejected(xml("ecdsa", Arrays.copyOf(privateKey, privateKey.length + 1),
+                new X509Certificate[] { keybox.issuer, keybox.root }));
+        expectRejected(xml("ecdsa", privateKey, new X509Certificate[] { keybox.issuer }));
+
+        int start = valid.indexOf("<PrivateKey>") + "<PrivateKey>".length();
+        int end = valid.indexOf("</PrivateKey>");
+        expectRejected(valid.substring(0, start) + "not*base64" + valid.substring(end));
+    }
+
+    @Test
+    public void commonKeyboxFileFormatIsAccepted() throws Exception {
+        // Layout of keybox files as distributed: counts, DeviceID, PEM blocks with format="pem",
+        // SEC1 and PKCS#1 private keys, an EC and an RSA key in one keybox.
+        KeyboxMaterial ec = createKeybox("EC");
+        KeyboxMaterial rsa = createKeybox("RSA");
+        String xml = "<?xml version=\"1.0\"?>\n<AndroidAttestation>\n"
+                + "<NumberOfKeyboxes>1</NumberOfKeyboxes>\n"
+                + "<Keybox DeviceID=\"test\">\n"
+                + key("ecdsa", pem("EC PRIVATE KEY", innerKey(ec.issuerKey)), ec)
+                + key("rsa", pem("RSA PRIVATE KEY", innerKey(rsa.issuerKey)), rsa)
+                + "</Keybox>\n</AndroidAttestation>\n";
+        PlayKeybox.ParsedKeybox parsed = PlayKeybox.parse(xml.getBytes());
+        assertEquals("EC, RSA", parsed.getAlgorithms());
+
+        expectRejected(xml.replace("format=\"pem\"", "format=\"der\""));
+        expectRejected(xml.replace("DeviceID=", "Other="));
+    }
+
+    private static String key(String algorithm, String privateKeyPem, KeyboxMaterial material)
+            throws Exception {
+        return "<Key algorithm=\"" + algorithm + "\">\n"
+                + "<PrivateKey format=\"pem\">\n" + privateKeyPem + "</PrivateKey>\n"
+                + "<CertificateChain>\n<NumberOfCertificates>2</NumberOfCertificates>\n"
+                + "<Certificate format=\"pem\">\n"
+                + pem("CERTIFICATE", material.issuer.getEncoded()) + "</Certificate>\n"
+                + "<Certificate format=\"pem\">\n"
+                + pem("CERTIFICATE", material.root.getEncoded()) + "</Certificate>\n"
+                + "</CertificateChain>\n</Key>\n";
+    }
+
+    /** SEC1 (with its named curve, as OpenSSL writes it) or PKCS#1 encoding of a key. */
+    private static byte[] innerKey(KeyPair keyPair) throws Exception {
+        org.bouncycastle.asn1.pkcs.PrivateKeyInfo info = org.bouncycastle.asn1.pkcs.PrivateKeyInfo
+                .getInstance(keyPair.getPrivate().getEncoded());
+        if (!"EC".equals(keyPair.getPrivate().getAlgorithm())) {
+            return info.parsePrivateKey().toASN1Primitive().getEncoded();
+        }
+        BigInteger s = org.bouncycastle.asn1.sec.ECPrivateKey
+                .getInstance(info.parsePrivateKey()).getKey();
+        return new org.bouncycastle.asn1.sec.ECPrivateKey(256, s,
+                info.getPrivateKeyAlgorithm().getParameters()).getEncoded();
+    }
+
+    private static String pem(String type, byte[] der) {
+        return "-----BEGIN " + type + "-----\n"
+                + Base64.getMimeEncoder(64, new byte[] { '\n' }).encodeToString(der)
+                + "\n-----END " + type + "-----\n";
+    }
+
+    private static void expectRejected(String xml) throws Exception {
+        try {
+            PlayKeybox.parse(xml.getBytes());
+            fail("Expected malformed keybox to be rejected");
+        } catch (Exception expected) {
+            // Expected.
+        }
+    }
+
+    private static void checkKeybox(String algorithm) throws Exception {
+        KeyboxMaterial keybox = createKeybox(algorithm);
+        // Deliberately reverse the chain; the parser must reconstruct issuer -> root order.
+        String xml = xml("EC".equals(algorithm) ? "ecdsa" : "rsa",
+                keybox.issuerKey.getPrivate().getEncoded(),
+                new X509Certificate[] { keybox.root, keybox.issuer });
+        PlayKeybox.ParsedKeybox parsed = PlayKeybox.parse(xml.getBytes());
+
+        KeyPair realIssuerKey = keyPair(algorithm);
+        X509Certificate realIssuer = certificate("Real issuer", "Real issuer",
+                realIssuerKey.getPublic(), realIssuerKey.getPrivate(), realIssuerKey.getPublic(),
+                false);
+        KeyPair applicationKey = keyPair(algorithm);
+        X509Certificate realLeaf = certificate("Real leaf", "Real issuer",
+                applicationKey.getPublic(), realIssuerKey.getPrivate(), realIssuerKey.getPublic(),
+                true);
+        Certificate[] realChain = { realLeaf, realIssuer };
+
+        Certificate[] rewritten = parsed.maybeRewrite(realChain);
+        assertEquals(3, rewritten.length);
+        X509Certificate replacement = (X509Certificate) rewritten[0];
+        assertArrayEquals(applicationKey.getPublic().getEncoded(),
+                replacement.getPublicKey().getEncoded());
+        assertArrayEquals(realLeaf.getExtensionValue(PlayKeybox.ATTESTATION_EXTENSION_OID),
+                replacement.getExtensionValue(PlayKeybox.ATTESTATION_EXTENSION_OID));
+        replacement.verify(keybox.issuerKey.getPublic());
+        assertArrayEquals(keybox.issuer.getEncoded(), rewritten[1].getEncoded());
+        assertArrayEquals(keybox.root.getEncoded(), rewritten[2].getEncoded());
+
+        X509Certificate ordinaryLeaf = certificate("Ordinary leaf", "Real issuer",
+                applicationKey.getPublic(), realIssuerKey.getPrivate(), realIssuerKey.getPublic(),
+                false);
+        assertNull(parsed.maybeRewrite(new Certificate[] { ordinaryLeaf, realIssuer }));
+    }
+
+    private static KeyboxMaterial createKeybox(String algorithm) throws Exception {
+        KeyPair rootKey = keyPair(algorithm);
+        X509Certificate root = certificate("Test root", "Test root", rootKey.getPublic(),
+                rootKey.getPrivate(), rootKey.getPublic(), false);
+        KeyPair issuerKey = keyPair(algorithm);
+        X509Certificate issuer = certificate("Test issuer", "Test root", issuerKey.getPublic(),
+                rootKey.getPrivate(), rootKey.getPublic(), false);
+        return new KeyboxMaterial(root, issuer, issuerKey);
+    }
+
+    private static KeyPair keyPair(String algorithm) throws Exception {
+        KeyPairGenerator generator = KeyPairGenerator.getInstance(algorithm);
+        if ("EC".equals(algorithm)) {
+            generator.initialize(256);
+        } else {
+            generator.initialize(2048);
+        }
+        return generator.generateKeyPair();
+    }
+
+    private static X509Certificate certificate(String subject, String issuer,
+            PublicKey publicKey, PrivateKey signingKey, PublicKey issuerPublicKey,
+            boolean attested) throws Exception {
+        Instant now = Instant.now();
+        X509v3CertificateBuilder builder = new X509v3CertificateBuilder(
+                new X500Name("CN=" + issuer), BigInteger.valueOf(serial++),
+                Date.from(now.minus(1, ChronoUnit.HOURS)),
+                Date.from(now.plus(1, ChronoUnit.DAYS)), new X500Name("CN=" + subject),
+                SubjectPublicKeyInfo.getInstance(publicKey.getEncoded()));
+        if (attested) {
+            builder.addExtension(new Extension(
+                    new ASN1ObjectIdentifier(PlayKeybox.ATTESTATION_EXTENSION_OID), false,
+                    new DEROctetString(new byte[] { 1, 2, 3, 4 })));
+        }
+        String signatureAlgorithm = "EC".equals(signingKey.getAlgorithm())
+                ? "SHA256withECDSA" : "SHA256withRSA";
+        // The platform's default provider (Conscrypt) signs both EC and RSA.
+        JcaContentSignerBuilder signerBuilder = new JcaContentSignerBuilder(signatureAlgorithm);
+        X509CertificateHolder holder = builder.build(signerBuilder.build(signingKey));
+        X509Certificate certificate = (X509Certificate) CertificateFactory.getInstance("X.509")
+                .generateCertificate(new ByteArrayInputStream(holder.getEncoded()));
+        certificate.verify(issuerPublicKey);
+        return certificate;
+    }
+
+    private static String xml(String algorithm, byte[] privateKey,
+            X509Certificate[] certificates) throws Exception {
+        StringBuilder xml = new StringBuilder();
+        xml.append("<AndroidAttestation><Keybox><Key algorithm=\"")
+                .append(algorithm).append("\"><PrivateKey>")
+                .append(Base64.getEncoder().encodeToString(privateKey))
+                .append("</PrivateKey><CertificateChain>");
+        for (X509Certificate certificate : certificates) {
+            xml.append("<Certificate>")
+                    .append(Base64.getEncoder().encodeToString(certificate.getEncoded()))
+                    .append("</Certificate>");
+        }
+        return xml.append("</CertificateChain></Key></Keybox></AndroidAttestation>").toString();
+    }
+
+    private static final class KeyboxMaterial {
+        final X509Certificate root;
+        final X509Certificate issuer;
+        final KeyPair issuerKey;
+
+        KeyboxMaterial(X509Certificate root, X509Certificate issuer, KeyPair issuerKey) {
+            this.root = root;
+            this.issuer = issuer;
+            this.issuerKey = issuerKey;
+        }
+    }
+}
