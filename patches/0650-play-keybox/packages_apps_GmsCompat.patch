diff --git a/src/app/grapheneos/gmscompat/BinderGms2Gca.kt b/src/app/grapheneos/gmscompat/BinderGms2Gca.kt
index be60a9cddb354bc73163524911cdab37bfd41c8d..6825f7156516cee09fbd0a964ab6692e2b1248c4 100644
--- a/src/app/grapheneos/gmscompat/BinderGms2Gca.kt
+++ b/src/app/grapheneos/gmscompat/BinderGms2Gca.kt
@@ -2,6 +2,7 @@ package app.grapheneos.gmscompat
 
 import android.app.ApplicationErrorReport
 import android.app.Notification
+import android.app.compat.gms.GmsCompat
 import android.app.PendingIntent
 import android.content.Context
 import android.content.Intent
@@ -22,6 +23,7 @@ import android.provider.Settings
 import android.util.ArrayMap
 import android.util.Log
 import app.grapheneos.gmscompat.GmsCompatConfigParser.configHolderInfo
+import app.grapheneos.gmscompat.keybox.KeyboxStore
 import com.android.internal.gmscompat.GmsCompatConfig
 import com.android.internal.gmscompat.GmsInfo
 import com.android.internal.gmscompat.GmsInfo.PACKAGE_GMS_CORE
@@ -475,4 +477,25 @@ object BinderGms2Gca : IGms2Gca.Stub() {
     override fun maybeShowRcsRequirementsNotification(isTs43Verification: Boolean) {
         Notifications.handleRcsNotification(isTs43Verification)
     }
+
+    override fun rewriteAttestationChain(chain: ByteArray): ByteArray? {
+        val callingUid = Binder.getCallingUid()
+        val pm = ctx.packageManager
+        val gmsInfo = pm.getApplicationInfo(PACKAGE_GMS_CORE, 0)
+        if (gmsInfo.uid != callingUid || !GmsCompat.isEnabledFor(gmsInfo)) {
+            throw SecurityException("Caller is not unprivileged, Google-signed Play services")
+        }
+
+        // Fresh GMS installs leave the legacy GSF shared UID. On upgraded installs, an inert
+        // hasCode=false GSF sibling is the only other package allowed to share this UID. No
+        // arbitrary package can therefore invoke this binder method by name or by shared UID.
+        val uidPackages = pm.getPackagesForUid(callingUid) ?: throw SecurityException()
+        uidPackages.forEach { pkgName ->
+            if (pkgName == PACKAGE_GMS_CORE) return@forEach
+            if (pkgName != PackageId.GSF_NAME || pm.getApplicationInfo(pkgName, 0).hasCode()) {
+                throw SecurityException("Unexpected package in Play services UID")
+            }
+        }
+        return KeyboxStore.rewriteAttestationChain(chain)
+    }
 }
diff --git a/src/app/grapheneos/gmscompat/keybox/KeyboxActivity.kt b/src/app/grapheneos/gmscompat/keybox/KeyboxActivity.kt
new file mode 100644
index 0000000000000000000000000000000000000000..ec9fe098efef48a112664daadac7905c8d8d9dfa
--- /dev/null
+++ b/src/app/grapheneos/gmscompat/keybox/KeyboxActivity.kt
@@ -0,0 +1,137 @@
+package app.grapheneos.gmscompat.keybox
+
+import android.app.AlertDialog
+import android.app.compat.gms.GmsCompat
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.text.format.DateFormat
+import android.widget.Toast
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.preference.Preference
+import androidx.preference.PreferenceFragmentCompat
+import androidx.preference.SwitchPreferenceCompat
+import app.grapheneos.gmscompat.App
+import app.grapheneos.gmscompat.R
+import com.android.internal.gmscompat.GmsInfo.PACKAGE_GMS_CORE
+import com.android.internal.gmscompat.PlayKeybox
+import com.android.settingslib.collapsingtoolbar.CollapsingToolbarBaseActivity
+import com.android.settingslib.widget.FooterPreference
+
+class KeyboxActivity : CollapsingToolbarBaseActivity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setTitle(R.string.keybox_title)
+        if (savedInstanceState == null) {
+            supportFragmentManager.beginTransaction()
+                .replace(com.android.settingslib.collapsingtoolbar.R.id.content_frame,
+                    KeyboxFragment())
+                .commit()
+        }
+    }
+}
+
+class KeyboxFragment : PreferenceFragmentCompat() {
+    private lateinit var enabledPref: SwitchPreferenceCompat
+    private lateinit var statusPref: Preference
+    private lateinit var importPref: Preference
+    private lateinit var clearPref: Preference
+    private val mainHandler = Handler(Looper.getMainLooper())
+
+    private val openKeybox = registerForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+        uri ?: return@registerForActivityResult
+        val context = requireContext().applicationContext
+        App.bgExecutor().execute {
+            val result = runCatching {
+                val bytes = context.contentResolver.openInputStream(uri)?.use {
+                    it.readNBytes(PlayKeybox.MAX_XML_BYTES + 1)
+                } ?: throw IllegalArgumentException("Unable to open keybox")
+                KeyboxStore.importKeybox(bytes)
+            }
+            mainHandler.post {
+                if (!isAdded) return@post
+                if (result.isSuccess) {
+                    Toast.makeText(context, R.string.keybox_imported, Toast.LENGTH_LONG).show()
+                } else {
+                    Toast.makeText(context, R.string.keybox_import_failed, Toast.LENGTH_LONG).show()
+                }
+                refresh()
+            }
+        }
+    }
+
+    override fun onCreatePreferences(savedInstanceState: Bundle?, rootKey: String?) {
+        val context = preferenceManager.context
+        val screen = preferenceManager.createPreferenceScreen(context)
+        preferenceScreen = screen
+
+        enabledPref = SwitchPreferenceCompat(context).apply {
+            title = getString(R.string.keybox_enabled_title)
+            summary = getString(R.string.keybox_enabled_summary)
+            isPersistent = false
+            setOnPreferenceChangeListener { _, value ->
+                runCatching { KeyboxStore.setEnabled(value as Boolean) }.isSuccess
+            }
+        }
+        screen.addPreference(enabledPref)
+
+        statusPref = Preference(context).apply { isSelectable = false }
+        screen.addPreference(statusPref)
+
+        importPref = Preference(context).apply {
+            title = getString(R.string.keybox_import_title)
+            summary = getString(R.string.keybox_import_summary)
+            setOnPreferenceClickListener {
+                openKeybox.launch(arrayOf("*/*"))
+                true
+            }
+        }
+        screen.addPreference(importPref)
+
+        clearPref = Preference(context).apply {
+            title = getString(R.string.keybox_clear_title)
+            summary = getString(R.string.keybox_clear_summary)
+            setOnPreferenceClickListener {
+                AlertDialog.Builder(context)
+                    .setTitle(R.string.keybox_clear_title)
+                    .setMessage(R.string.keybox_clear_confirm)
+                    .setPositiveButton(R.string.keybox_clear_button) { _, _ ->
+                        KeyboxStore.clear()
+                        refresh()
+                    }
+                    .setNegativeButton(android.R.string.cancel, null)
+                    .show()
+                true
+            }
+        }
+        screen.addPreference(clearPref)
+
+        screen.addPreference(FooterPreference(context).apply {
+            setTitle(R.string.keybox_explanation)
+            isSelectable = false
+        })
+    }
+
+    override fun onResume() {
+        super.onResume()
+        refresh()
+    }
+
+    private fun refresh() {
+        val state = KeyboxStore.state()
+        val playInstalled = GmsCompat.isEnabledFor(PACKAGE_GMS_CORE, requireContext().userId)
+        enabledPref.isChecked = state.enabled && playInstalled
+        enabledPref.isEnabled = state.usable && playInstalled
+        clearPref.isEnabled = state.configured
+        statusPref.title = when {
+            !playInstalled -> getString(R.string.keybox_play_missing)
+            !state.configured -> getString(R.string.keybox_not_configured)
+            !state.usable -> getString(R.string.keybox_not_valid_now)
+            else -> {
+                val expiry = DateFormat.getMediumDateFormat(requireContext())
+                    .format(state.earliestExpiry)
+                getString(R.string.keybox_configured, state.algorithms, expiry)
+            }
+        }
+    }
+}
diff --git a/src/app/grapheneos/gmscompat/keybox/KeyboxPackageReceiver.kt b/src/app/grapheneos/gmscompat/keybox/KeyboxPackageReceiver.kt
