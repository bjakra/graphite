         }
     }
 
+    /**
+     * Graphite: opens the user's wallet. Prefers the default contactless payment app (Settings →
+     * Connected devices → Contactless payments), so any wallet works, not only Google's; falls back
+     * to the QuickAccessWallet provider, then to the payment settings.
+     */
+    final class WalletAction extends SinglePressAction {
+        WalletAction() {
+            super(com.android.systemui.res.R.drawable.ic_qs_wallet,
+                    com.android.systemui.res.R.string.global_action_wallet);
+        }
+
+        @Override
+        public boolean showDuringKeyguard() {
+            return true;
+        }
+
+        @Override
+        public boolean showBeforeProvisioning() {
+            return false;
+        }
+
+        @Override
+        public void onPress() {
+            Intent intent = getDefaultPaymentAppIntent();
+            if (intent == null) {
+                intent = android.service.quickaccesswallet.QuickAccessWalletClient
+                        .create(mContext).createWalletIntent();
+            }
+            if (intent == null) {
+                // Not ACTION_NFC_PAYMENT_SETTINGS: Settings rejects that fragment on Android 17.
+                intent = new Intent(android.provider.Settings.ACTION_MANAGE_DEFAULT_APPS_SETTINGS);
+            }
+            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            mActivityStarter.startActivity(intent, true /* dismissShade */);
+        }
+
+        private Intent getDefaultPaymentAppIntent() {
+            try {
+                // Same setting CardEmulation.getPreferredPaymentService() reads.
+                String setting = android.provider.Settings.Secure.getString(
+                        mContext.getContentResolver(),
+                        android.provider.Settings.Secure.NFC_PAYMENT_DEFAULT_COMPONENT);
+                ComponentName service = setting == null
+                        ? null : ComponentName.unflattenFromString(setting);
+                if (service == null) {
+                    return null;
+                }
+                return mContext.getPackageManager()
+                        .getLaunchIntentForPackage(service.getPackageName());
+            } catch (RuntimeException e) {
+                Log.w(TAG, "Could not resolve the default payment app", e);
+                return null;
+            }
+        }
+    }
+
     /** Graphite: restarts SystemUI only (quick fix for a stuck UI, keeps apps running). */
     final class RestartSystemUiAction extends SinglePressAction {
         RestartSystemUiAction() {
diff --git a/packages/SystemUI/src/com/android/systemui/globalactions/shared/model/GlobalActionType.kt b/packages/SystemUI/src/com/android/systemui/globalactions/shared/model/GlobalActionType.kt
