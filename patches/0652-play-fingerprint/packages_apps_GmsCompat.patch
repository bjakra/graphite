diff --git a/src/app/grapheneos/gmscompat/fingerprint/FingerprintBootReceiver.kt b/src/app/grapheneos/gmscompat/fingerprint/FingerprintBootReceiver.kt
new file mode 100644
index 0000000000000000000000000000000000000000..ae94368cd5d66aad7179b3e1e318112792637a5e
--- /dev/null
+++ b/src/app/grapheneos/gmscompat/fingerprint/FingerprintBootReceiver.kt
@@ -0,0 +1,22 @@
+package app.grapheneos.gmscompat.fingerprint
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.util.Log
+import app.grapheneos.gmscompat.App
+
+/**
+ * Refreshes the Pixel Canary fingerprint on every boot when the feature is on. A failed fetch leaves
+ * the last stored value in place; it never blocks boot (the work runs on a background executor).
+ */
+class FingerprintBootReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action != Intent.ACTION_BOOT_COMPLETED) return
+        if (!FingerprintStore.state().enabled) return
+        App.bgExecutor().execute {
+            runCatching { PlayFingerprint.fetch()?.let { FingerprintStore.store(it) } }
+                .onFailure { Log.w("PlayFingerprint", "boot refresh failed: ${it.javaClass.simpleName}") }
+        }
+    }
+}
diff --git a/src/app/grapheneos/gmscompat/fingerprint/FingerprintStore.kt b/src/app/grapheneos/gmscompat/fingerprint/FingerprintStore.kt
new file mode 100644
index 0000000000000000000000000000000000000000..176c171698ba7ea774e280451ecc1f01c1f4cbbd
--- /dev/null
+++ b/src/app/grapheneos/gmscompat/fingerprint/FingerprintStore.kt
@@ -0,0 +1,140 @@
+package app.grapheneos.gmscompat.fingerprint
+
+import android.content.Context
+import android.os.FileUtils
+import android.util.ArrayMap
+import android.util.AtomicFile
+import android.util.Log
+import app.grapheneos.gmscompat.App
+import app.grapheneos.gmscompat.BinderGms2Gca
+import com.android.internal.gmscompat.GmsCompatApp
+import com.android.internal.gmscompat.GmsCompatConfig
+import java.io.File
+import java.io.FileOutputStream
+
+/**
+ * Per-user storage for the Play Integrity device fingerprint (patch 0652). Holds the last fetched
+ * Pixel Canary fingerprint and the on/off switch, and feeds the values into GmsCompatConfig so the
+ * sandboxed Play services process can present them. The fingerprint is a public build string, not
+ * secret, so it uses ordinary app storage (unlike the keybox).
+ */
+object FingerprintStore {
+    private const val TAG = "PlayFingerprintStore"
+    private const val PROPS_FILE = "play_fingerprint.props"
+    private const val ENABLED_FILE = "play_fingerprint.enabled"
+
+    // Build fields understood by PlayFingerprintSpoof; only these are persisted and spoofed.
+    val BUILD_KEYS = listOf(
+        "BRAND", "MANUFACTURER", "MODEL", "DEVICE", "PRODUCT",
+        "FINGERPRINT", "SECURITY_PATCH", "DEVICE_INITIAL_SDK_INT",
+    )
+
+    // Metadata lines, kept out of the Build props handed to the framework.
+    private const val META_RELEASED = "_released"
+    private const val META_EXPIRES = "_expires"
+    private const val META_FETCHED = "_fetched"
+
+    private val lock = Any()
+
+    data class State(
+        val enabled: Boolean,
+        val fingerprint: String?,
+        val released: String?,
+        val expires: String?,
+        val fetchedAt: String?,
+    )
+
+    private val ctx: Context get() = App.ctx()
+
+    private fun propsFile() = File(ctx.filesDir, PROPS_FILE)
+    private fun enabledFile() = File(ctx.filesDir, ENABLED_FILE)
+
+    private fun readProps(): Map<String, String> {
+        val file = propsFile()
+        if (!file.isFile) return emptyMap()
+        return try {
+            val map = LinkedHashMap<String, String>()
+            file.readLines().forEach { line ->
+                val i = line.indexOf('=')
+                if (i > 0) map[line.substring(0, i)] = line.substring(i + 1)
+            }
+            map
+        } catch (e: Exception) {
+            Log.w(TAG, "Unreadable fingerprint: ${e.javaClass.simpleName}")
+            emptyMap()
+        }
+    }
+
+    private fun isEnabledRaw(): Boolean =
+        runCatching { enabledFile().readText() == "1" }.getOrDefault(false)
+
+    fun state(): State = synchronized(lock) {
+        val props = readProps()
+        State(
+            enabled = isEnabledRaw(),
+            fingerprint = props["FINGERPRINT"],
+            released = props[META_RELEASED],
+            expires = props[META_EXPIRES],
+            fetchedAt = props[META_FETCHED],
+        )
+    }
+
+    /** Turns the feature on/off and pushes the change to the live Play services process. */
+    fun setEnabled(value: Boolean) = synchronized(lock) {
+        writeAtomic(enabledFile(), if (value) "1" else "0")
+        notifyConfigChanged()
+    }
+
+    /** Persists a freshly fetched fingerprint and pushes it out. Does not change the on/off state. */
+    fun store(result: PlayFingerprint.Result) = synchronized(lock) {
+        val sb = StringBuilder()
+        for ((k, v) in result.buildProps) {
+            if (k in BUILD_KEYS) sb.append(k).append('=').append(v).append('\n')
+        }
+        result.released?.let { sb.append(META_RELEASED).append('=').append(it).append('\n') }
+        result.expires?.let { sb.append(META_EXPIRES).append('=').append(it).append('\n') }
+        sb.append(META_FETCHED).append('=').append(result.fetchedAt).append('\n')
+        writeAtomic(propsFile(), sb.toString())
+        notifyConfigChanged()
+    }
+
+    /** Called by GmsCompatConfigParser: attach the spoof to the config when on and present. */
+    fun populateConfig(config: GmsCompatConfig) = synchronized(lock) {
+        if (!isEnabledRaw()) return
+        val props = readProps()
+        val out = ArrayMap<String, String>()
+        for (key in BUILD_KEYS) {
+            val value = props[key]
+            if (value != null) out[key] = value
+        }
+        if (!out.isEmpty()) {
+            config.spoofedBuildProps = out
+        }
+    }
+
+    private fun notifyConfigChanged() {
+        try {
+            BinderGms2Gca.updateConfig()
+            ctx.sendBroadcast(
+                android.content.Intent(GmsCompatApp.CONFIG_UPDATED_BROADCAST),
+                GmsCompatApp.CLIENT_PERMISSION,
+            )
+        } catch (e: Exception) {
+            Log.w(TAG, "Unable to push config update: ${e.javaClass.simpleName}")
+        }
+    }
+
+    private fun writeAtomic(file: File, text: String) {
+        val atomic = AtomicFile(file)
+        var stream: FileOutputStream? = null
+        try {
+            stream = atomic.startWrite()
+            stream.write(text.toByteArray())
+            atomic.finishWrite(stream)
+            FileUtils.setPermissions(file.absolutePath, 384, -1, -1) // 0600
+        } catch (e: Exception) {
+            atomic.failWrite(stream)
+            throw e
+        }
+    }
+}
diff --git a/src/app/grapheneos/gmscompat/fingerprint/PlayFingerprint.kt b/src/app/grapheneos/gmscompat/fingerprint/PlayFingerprint.kt
new file mode 100644
index 0000000000000000000000000000000000000000..3bed2de96ca8b5beb72fceba29c390ea38c4976a
--- /dev/null
+++ b/src/app/grapheneos/gmscompat/fingerprint/PlayFingerprint.kt
@@ -0,0 +1,187 @@
+package app.grapheneos.gmscompat.fingerprint
+
+import android.util.Log
+import org.json.JSONArray
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.TimeZone
+
+/**
+ * Fetches the current Pixel 8 Pro ("husky") Canary build fingerprint from Google's own servers,
+ * mirroring PlayIntegrityFork's autopif4 flow but locked to husky so the device-list crawl isn't
+ * needed. Only a short, public build fingerprint is pulled; nothing is executed. Any failure returns
+ * null and the caller leaves the real device identity in place (no fallback, by design).
+ *
+ * Sources, all Google:
+ *  - https://flash.android.com                       -> Android Flash Tool client key
+ *  - https://content-flashstation-pa.googleapis.com  -> latest husky_beta Canary build id/incremental
+ *  - https://source.android.com/.../bulletin/pixel   -> matching security patch level (best effort)
+ */
+object PlayFingerprint {
+    private const val TAG = "PlayFingerprint"
+
+    private const val PRODUCT = "husky_beta"
+    private const val DEVICE = "husky"
+    private const val MODEL = "Pixel 8 Pro"
+    private const val DEVICE_INITIAL_SDK_INT = "34" // Pixel 8 series first API level
+
+    private const val FLASH_URL = "https://flash.android.com/"
+    private const val STATION_URL = "https://content-flashstation-pa.googleapis.com/v1/builds"
+    private const val BULLETIN_URL = "https://source.android.com/docs/security/bulletin/pixel"
+
+    private const val TIMEOUT_MS = 10_000
+    private const val MAX_BYTES = 4 * 1024 * 1024
+
+    data class Result(
+        val buildProps: Map<String, String>,
+        val released: String?,
+        val expires: String?,
+        val fetchedAt: String,
+    )
+
+    /** Blocking; run off the main thread. Returns null if a usable fingerprint can't be built. */
+    fun fetch(): Result? {
+        try {
+            val key = extractClientKey(httpGet(FLASH_URL, null) ?: return fail("no flash page"))
+                ?: return fail("no client key")
+
+            val stationJson = httpGet(
+                "$STATION_URL?product=$PRODUCT&key=$key",
+                mapOf("Referer" to "https://flash.android.com"),
+            ) ?: return fail("no station response")
+
+            val canary = latestCanary(stationJson) ?: return fail("no canary build")
+            val id = canary.optString("releaseCandidateName").takeIf { it.isNotBlank() }
+                ?: return fail("no build id")
+            val incremental = canary.optString("buildId").takeIf { it.isNotBlank() }
+                ?: return fail("no incremental")
+
+            val fingerprint = "google/$PRODUCT/$DEVICE:CANARY/$id/$incremental:user/release-keys"
+
+            val released = canary.optString("factoryImageDownloadUrl")
+                .takeIf { it.isNotBlank() }?.let { releaseDate(it) }
+            val expires = released?.let { plusWeeks(it, 6) }
+            val securityPatch = securityPatch(canary)
+
+            val props = LinkedHashMap<String, String>()
+            props["BRAND"] = "google"
+            props["MANUFACTURER"] = "Google"
+            props["MODEL"] = MODEL
+            props["DEVICE"] = DEVICE
+            props["PRODUCT"] = PRODUCT
+            props["FINGERPRINT"] = fingerprint
+            if (securityPatch != null) props["SECURITY_PATCH"] = securityPatch
+            props["DEVICE_INITIAL_SDK_INT"] = DEVICE_INITIAL_SDK_INT
+
+            return Result(props, released, expires, today())
+        } catch (e: Exception) {
+            return fail(e.javaClass.simpleName)
+        }
+    }
+
+    private fun fail(reason: String): Result? {
+        Log.w(TAG, "Fingerprint fetch failed: $reason")
+        return null
+    }
+
+    // flash.android.com embeds the key in <body data-client-config="region;KEY&...;...">.
+    private fun extractClientKey(html: String): String? {
+        val attr = Regex("data-client-config=\"([^\"]*)\"").find(html)?.groupValues?.get(1)
+            ?: return null
+        val parts = attr.split(';')
+        if (parts.size < 2) return null
+        return parts[1].substringBefore('&').takeIf { it.isNotBlank() }
+    }
+
+    private fun latestCanary(json: String): JSONObject? {
+        val array = buildsArray(JSONObject(json)) ?: return null
+        var last: JSONObject? = null
+        for (i in 0 until array.length()) {
+            val o = array.optJSONObject(i) ?: continue
+            if (o.optBoolean("canary", false)) last = o
+        }
+        return last
+    }
+
+    private fun buildsArray(root: JSONObject): JSONArray? {
+        root.optJSONArray("builds")?.let { return it }
+        // Fall back to the first array-valued field, whatever it is named.
+        val keys = root.keys()
+        while (keys.hasNext()) {
+            root.optJSONArray(keys.next())?.let { return it }
+        }
+        return null
+    }
+
+    // Build id in the JSON looks like "...canary-YYMMDD..."; the Pixel bulletin lists the patch date.
+    private fun securityPatch(canary: JSONObject): String? {
+        val id = canary.optString("id")
+        val raw = Regex("canary-([0-9]{4,})").find(id)?.groupValues?.get(1) ?: return null
+        val prefix = raw.substring(0, 4).let { it.substring(0, 2) + "-" + it.substring(2, 4) }
+        return try {
+            val bulletin = httpGet(BULLETIN_URL, null) ?: return null
+            // Row whose build cell starts with the canary prefix; the date cell is the patch level.
+            val row = Regex("<td>${Regex.escape(prefix)}[^<]*</td>\\s*<td>([0-9]{4}-[0-9]{2}-[0-9]{2})</td>")
+                .find(bulletin)?.groupValues?.get(1)
+            row
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    private fun releaseDate(factoryImageUrl: String): String? {
+        return try {
+            val conn = (URL(factoryImageUrl).openConnection() as HttpURLConnection).apply {
+                requestMethod = "HEAD"
+                connectTimeout = TIMEOUT_MS
+                readTimeout = TIMEOUT_MS
+                instanceFollowRedirects = true
+            }
+            try {
+                val lastModified = conn.getHeaderField("Last-Modified") ?: return null
+                val parser = SimpleDateFormat("EEE, dd MMM yyyy HH:mm:ss zzz", Locale.US)
+                parser.timeZone = TimeZone.getTimeZone("GMT")
+                val out = SimpleDateFormat("yyyy-MM-dd", Locale.US)
+                out.format(parser.parse(lastModified)!!)
+            } finally {
+                conn.disconnect()
+            }
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    private fun plusWeeks(date: String, weeks: Int): String? = try {
+        val fmt = SimpleDateFormat("yyyy-MM-dd", Locale.US)
+        val d = fmt.parse(date)!!
+        fmt.format(Date(d.time + weeks.toLong() * 7 * 24 * 60 * 60 * 1000))
+    } catch (e: Exception) {
+        null
+    }
+
+    private fun today(): String =
+        SimpleDateFormat("yyyy-MM-dd", Locale.US).format(Date())
+
+    private fun httpGet(urlStr: String, headers: Map<String, String>?): String? {
+        val conn = (URL(urlStr).openConnection() as HttpURLConnection).apply {
+            connectTimeout = TIMEOUT_MS
+            readTimeout = TIMEOUT_MS
+            instanceFollowRedirects = true
+            setRequestProperty("User-Agent", "Mozilla/5.0")
+            headers?.forEach { (k, v) -> setRequestProperty(k, v) }
+        }
+        try {
+            if (conn.responseCode != HttpURLConnection.HTTP_OK) {
+                return null
+            }
+            val bytes = conn.inputStream.use { it.readNBytes(MAX_BYTES) }
+            return String(bytes, Charsets.UTF_8)
+        } finally {
+            conn.disconnect()
+        }
+    }
+}
