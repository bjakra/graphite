From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bjarne <87858321+bjakra@users.noreply.github.com>
Date: Fri, 6 Nov 2026 16:50:51 +0100
Subject: [PATCH] Play Integrity: device fingerprint spoof for sandboxed Play
 services

Presents a fetched Pixel Canary build fingerprint to the Google Play services
process only. SystemProperties.get consults a per-process override map (null
except in the spoofed Play process); PlayFingerprintSpoof sets the Build fields
and ro.* overrides, scoped to GmsCompat.isGmsCore(), reverting cleanly. The
fetched props travel in GmsCompatConfig (new Parcel field). Java-layer only;
native __system_property_get is not covered (separate concern).

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>

---
 core/java/android/os/SystemProperties.java    |  25 ++++
 .../gmscompat/GmcConfigChangeListener.java    |   3 +
 .../internal/gmscompat/GmsCompatConfig.java   |  33 +++++
 .../android/internal/gmscompat/GmsHooks.java  |   5 +
 .../gmscompat/PlayFingerprintSpoof.java       | 140 ++++++++++++++++++
 5 files changed, 206 insertions(+)
 create mode 100644 core/java/com/android/internal/gmscompat/PlayFingerprintSpoof.java

diff --git a/core/java/android/os/SystemProperties.java b/core/java/android/os/SystemProperties.java
index 18b207a42f75e1f5c54464b11c09dd20c1365882..531b195b57272794a49799d3e81e958e3f5bafa7 100644
--- a/core/java/android/os/SystemProperties.java
+++ b/core/java/android/os/SystemProperties.java
@@ -137,6 +137,23 @@ public class SystemProperties {
     private static native void native_add_change_callback();
     private static native void native_report_sysprop_change();
 
+    // GrapheneOS Graphite: per-process, read-only property overrides. Null in every process except
+    // the sandboxed Google Play services process when the Play Integrity fingerprint feature is on,
+    // where it is set once at startup (see com.android.internal.gmscompat.PlayFingerprintSpoof).
+    // This only affects Java-level SystemProperties reads in that single process; the real
+    // properties, other processes and native __system_property_get are untouched.
+    private static volatile android.util.ArrayMap<String, String> sGraphiteOverrides;
+
+    /** @hide */
+    public static void setGraphiteOverrides(@Nullable android.util.ArrayMap<String, String> overrides) {
+        sGraphiteOverrides = overrides;
+    }
+
+    private static String graphiteOverride(String key) {
+        android.util.ArrayMap<String, String> overrides = sGraphiteOverrides;
+        return overrides != null ? overrides.get(key) : null;
+    }
+
     /**
      * Get the String value for the given {@code key}.
      *
@@ -148,6 +165,10 @@ public class SystemProperties {
     @SystemApi
     public static String get(@NonNull String key) {
         if (TRACK_KEY_ACCESS) onKeyAccess(key);
+        String override = graphiteOverride(key);
+        if (override != null) {
+            return override;
+        }
         return native_get(key);
     }
 
@@ -164,6 +185,10 @@ public class SystemProperties {
     @SystemApi
     public static String get(@NonNull String key, @Nullable String def) {
         if (TRACK_KEY_ACCESS) onKeyAccess(key);
+        String override = graphiteOverride(key);
+        if (override != null) {
+            return override;
+        }
         return native_get(key, def);
     }
 
diff --git a/core/java/com/android/internal/gmscompat/GmcConfigChangeListener.java b/core/java/com/android/internal/gmscompat/GmcConfigChangeListener.java
index 1db11fac81884d1e1b5d6b63209b54a4daf90444..7e7c881bae792a8ce8b76aa6d620ec4222d7de59 100644
--- a/core/java/com/android/internal/gmscompat/GmcConfigChangeListener.java
+++ b/core/java/com/android/internal/gmscompat/GmcConfigChangeListener.java
@@ -33,6 +33,9 @@ class GmcConfigChangeListener extends BroadcastReceiver {
         Log.i(TAG, "onReceive: " + intent);
         GmsCompatConfig newConfig = GmsCompatApp.call(i -> i.getConfig());
         GmsHooks.setConfig(newConfig);
+        // Pick up a fingerprint that was just fetched (manual "Update now"); turning the feature off
+        // reverts to the real values. Build fields set this way take effect for subsequent reads.
+        PlayFingerprintSpoof.apply(newConfig);
         onConfigUpdated(newConfig);
     }
 
