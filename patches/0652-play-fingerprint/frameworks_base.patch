diff --git a/core/java/com/android/internal/gmscompat/PlayFingerprintSpoof.java b/core/java/com/android/internal/gmscompat/PlayFingerprintSpoof.java
new file mode 100644
index 0000000000000000000000000000000000000000..220fc8e5279b55cf2e9b49a0e765d57ce921ce2c
--- /dev/null
+++ b/core/java/com/android/internal/gmscompat/PlayFingerprintSpoof.java
@@ -0,0 +1,140 @@
+/*
+ * Copyright (C) 2026 The Graphite Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.internal.gmscompat;
+
+import android.app.compat.gms.GmsCompat;
+import android.os.Build;
+import android.os.SystemProperties;
+import android.util.ArrayMap;
+import android.util.Log;
+
+import java.lang.reflect.Field;
+
+/**
+ * Applies the Play Integrity device-fingerprint spoof inside the sandboxed Google Play services
+ * process, and only there. The fetched fingerprint (patch 0652) arrives in GmsCompatConfig; this
+ * class overrides the matching {@link Build} fields and the Java-level {@link SystemProperties}
+ * reads so Play services sees a current Pixel build instead of this device's own.
+ *
+ * <p>Scope and limits, on purpose:
+ * <ul>
+ *   <li>Runs only when GmsCompat.isGmsCore(); no other app or process is affected.</li>
+ *   <li>Only Java reads are covered (Build.* and SystemProperties.get). DroidGuard also reads some
+ *       properties through native __system_property_get, which this does NOT intercept; covering
+ *       that would need a native hook, which is intentionally not part of this patch.</li>
+ *   <li>The real device identity, other processes and the property service are untouched.</li>
+ * </ul>
+ */
+public final class PlayFingerprintSpoof {
+    private static final String TAG = "GmsCompat/Fingerprint";
+
+    // config key -> android.os.Build (or Build.VERSION) field + the ro.* property it maps to
+    private static final class Mapping {
+        final Class<?> holder;
+        final String field;
+        final String property;
+
+        Mapping(Class<?> holder, String field, String property) {
+            this.holder = holder;
+            this.field = field;
+            this.property = property;
+        }
+    }
+
+    private static final ArrayMap<String, Mapping> MAPPINGS = new ArrayMap<>();
+    static {
+        MAPPINGS.put("BRAND", new Mapping(Build.class, "BRAND", "ro.product.brand"));
+        MAPPINGS.put("MANUFACTURER", new Mapping(Build.class, "MANUFACTURER", "ro.product.manufacturer"));
+        MAPPINGS.put("MODEL", new Mapping(Build.class, "MODEL", "ro.product.model"));
+        MAPPINGS.put("DEVICE", new Mapping(Build.class, "DEVICE", "ro.product.device"));
+        MAPPINGS.put("PRODUCT", new Mapping(Build.class, "PRODUCT", "ro.product.name"));
+        MAPPINGS.put("FINGERPRINT", new Mapping(Build.class, "FINGERPRINT", "ro.build.fingerprint"));
+        MAPPINGS.put("SECURITY_PATCH",
+                new Mapping(Build.VERSION.class, "SECURITY_PATCH", "ro.build.version.security_patch"));
+        MAPPINGS.put("DEVICE_INITIAL_SDK_INT",
+                new Mapping(Build.VERSION.class, "DEVICE_INITIAL_SDK_INT", "ro.product.first_api_level"));
+    }
+
+    // The genuine values, captured once before anything is overridden, so the spoof can be fully
+    // undone if the feature is turned off while the process keeps running.
+    private static ArrayMap<String, String> originalValues;
+    private static boolean active;
+
+    private PlayFingerprintSpoof() {}
+
+    public static synchronized void apply(GmsCompatConfig config) {
+        if (!GmsCompat.isGmsCore()) {
+            return;
+        }
+        ArrayMap<String, String> props = config != null ? config.spoofedBuildProps : null;
+        if (props == null || props.isEmpty()) {
+            restore();
+            return;
+        }
+
+        if (originalValues == null) {
+            captureOriginals();
+        }
+
+        ArrayMap<String, String> propertyOverrides = new ArrayMap<>();
+        for (int i = 0; i < props.size(); i++) {
+            String key = props.keyAt(i);
+            String value = props.valueAt(i);
+            Mapping mapping = MAPPINGS.get(key);
+            if (mapping == null || value == null) {
+                continue;
+            }
+            setField(mapping, value);
+            propertyOverrides.put(mapping.property, value);
+        }
+        // Keep whatever we don't spoof reading through to the real value.
+        SystemProperties.setGraphiteOverrides(propertyOverrides);
+        active = true;
+        Log.i(TAG, "Applied Play Integrity fingerprint spoof (" + propertyOverrides.size() + " props)");
+    }
+
+    private static void restore() {
+        if (!active || originalValues == null) {
+            return;
+        }
+        for (int i = 0; i < MAPPINGS.size(); i++) {
+            String key = MAPPINGS.keyAt(i);
+            if (originalValues.containsKey(key)) {
+                setField(MAPPINGS.valueAt(i), originalValues.get(key));
+            }
+        }
+        SystemProperties.setGraphiteOverrides(null);
+        active = false;
+        Log.i(TAG, "Reverted Play Integrity fingerprint spoof");
+    }
+
+    private static void captureOriginals() {
+        originalValues = new ArrayMap<>();
+        for (int i = 0; i < MAPPINGS.size(); i++) {
+            Mapping mapping = MAPPINGS.valueAt(i);
+            try {
+                Object current = mapping.holder.getField(mapping.field).get(null);
+                originalValues.put(MAPPINGS.keyAt(i), current != null ? String.valueOf(current) : null);
+            } catch (ReflectiveOperationException e) {
+                // Leave it absent; that field simply won't be restorable.
+            }
+        }
+    }
+
+    private static void setField(Mapping mapping, String value) {
+        try {
+            Field field = mapping.holder.getField(mapping.field);
+            field.setAccessible(true);
+            if (field.getType() == int.class) {
+                field.setInt(null, Integer.parseInt(value.trim()));
+            } else {
+                field.set(null, value);
+            }
+        } catch (ReflectiveOperationException | NumberFormatException e) {
+            Log.w(TAG, "Could not set Build." + mapping.field + ": " + e.getClass().getSimpleName());
+        }
+    }
+}
