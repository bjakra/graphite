+                }
+            }
+        }
     }
 
     public static final Creator<GmsCompatConfig> CREATOR = new Creator<>() {
@@ -126,6 +147,18 @@ public class GmsCompatConfig implements Parcelable {
             readStringArrayMapMap(p, r.forceComponentEnabledSettingsMap,
                     Parcel::readString, Parcel::readInt);
 
+            {
+                int cnt = p.readInt();
+                if (cnt >= 0) {
+                    ArrayMap<String, String> props = new ArrayMap<>(cnt);
+                    for (int i = 0; i < cnt; ++i) {
+                        String key = p.readString();
+                        props.put(key, p.readString());
+                    }
+                    r.spoofedBuildProps = props;
